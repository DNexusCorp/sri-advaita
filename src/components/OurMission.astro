---
/**
 * OurMission.astro — Educational Mission, Vision, and Core Commitments.
 * Minimal, authentic, human-centred content with zero data dumping.
 */

const missionCommitments = [
  {
    title: "Values over competition",
    description:
      "Every child is a person, not a test score. We focus on building curiosity and character.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Learning by finding out",
    description:
      "Ideas stay with children when they find them out for themselves, by trying things and talking about them.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  },
  {
    title: "Respect for everyone",
    description:
      "Children use English, Kannada and Tamil, and learn to respect one another and to care for nature and the community.",
    icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
  },
];
---

<section
  id="our-mission"
  class="relative isolate overflow-hidden bg-brand-cream-dark/50 py-16 text-brand-navy sm:py-20 lg:py-28"
  aria-labelledby="mission-heading"
>
  <span id="mission" class="sr-only">Our Mission</span>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Vision & Motto Callout (Left Column) -->
      <div class="lg:col-span-5">
        <div
          class="relative overflow-hidden rounded-3xl border border-brand-navy/15 bg-white p-8 sm:p-10 shadow-premium"
        >
          <div
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-3.5 py-1 text-xs font-semibold text-brand-gold-dark"
          >
            <span class="font-kannada font-bold">ಹಳೆ ಬೇರು, ಹೊಸ ಚಿಗುರು</span>
            <span>•</span>
            <span>Old Roots. New Shoots.</span>
          </div>

          <div
            class="font-serif text-5xl text-brand-gold/30 leading-none mb-1 select-none"
            aria-hidden="true"
          >
            “
          </div>

          <blockquote
            class="font-serif text-xl sm:text-2xl font-semibold leading-relaxed text-brand-navy -mt-3"
          >
            We want children to grow up kind and confident. That takes patient
            teachers and room to make mistakes.
          </blockquote>

          <div
            class="mt-8 pt-6 border-t border-brand-navy/10 flex items-center gap-4"
          >
            <div
              class="flex h-12 w-12 flex-none items-center justify-center rounded-2xl bg-brand-navy text-brand-gold-light font-serif font-bold text-lg"
            >
              SA
            </div>
            <div>
              <h4 class="font-serif text-sm font-bold text-brand-navy">
                The governing board and teachers
              </h4>
              <p class="text-xs text-brand-navy/70">
                Sri Advaita Educational Trust, Hosur
              </p>
              <p class="text-[11px] text-brand-gold-dark font-medium mt-0.5">
                In Mookandapalli since 2010
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Mission Statement & 3 Pillars (Right Column) -->
      <div class="lg:col-span-7 space-y-6">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-brand-navy/15 bg-white px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-navy/80 shadow-sm"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-gold"></span>
          What we stand for
        </span>

        <h2
          id="mission-heading"
          class="font-serif text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
        >
          What we are here to do
        </h2>

        <div
          class="space-y-4 text-sm sm:text-base leading-relaxed text-brand-navy/80"
        >
          <div class="rounded-2xl border border-brand-navy/10 bg-white/80 p-5">
            <h3 class="font-serif font-bold text-brand-navy text-base mb-1">
              Our vision
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              We hope children grow up knowing and valuing their own culture,
              and meet the modern world with courage and humility. We also hope
              they stay curious and kind.
            </p>
          </div>

          <div class="rounded-2xl border border-brand-navy/10 bg-white/80 p-5">
            <h3 class="font-serif font-bold text-brand-navy text-base mb-1">
              Our mission
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              We offer State Board education that is accessible to local
              families and taught clearly. Alongside lessons, children get time
              for sport and the arts, and we teach right from wrong. We want
              school to be a place they enjoy.
            </p>
          </div>
        </div>

        <!-- 3 Core Commitments -->
        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-3 pt-2">
          {
            missionCommitments.map((item) => (
              <div class="rounded-2xl border border-brand-navy/10 bg-white p-4 shadow-sm">
                <svg
                  class="h-5 w-5 text-brand-gold-dark mb-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={item.icon}
                  />
                </svg>
                <h4 class="font-serif text-xs font-bold text-brand-navy mb-1">
                  {item.title}
                </h4>
                <p class="text-[11px] text-slate-600 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
