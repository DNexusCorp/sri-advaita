---
/**
 * StickyWidgets.astro — Floating conversion and utility widgets:
 * 1. Floating WhatsApp Admissions Connect Button (desktop + mobile)
 * 2. Mobile Sticky Quick Action Bar (phones only, bottom dock)
 * 3. Smooth Scroll to Top Button
 */
---

<!-- Floating WhatsApp & Back to Top (Desktop & Tablet) -->
<aside class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3 pointer-events-none print:hidden">
  
  <!-- Back to Top Button -->
  <button
    id="back-to-top"
    type="button"
    aria-label="Scroll back to top of page"
    class="pointer-events-auto flex h-11 w-11 items-center justify-center rounded-full bg-brand-navy border border-brand-gold/40 text-brand-gold-light shadow-premium opacity-0 translate-y-4 transition-all duration-300 hover:bg-brand-navy-light hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold"
  >
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <!-- WhatsApp Floating Trigger with Pulse Glow -->
  <div class="pointer-events-auto relative group">
    <!-- Hover Tooltip -->
    <div class="absolute right-full top-1/2 -translate-y-1/2 mr-3 hidden whitespace-nowrap rounded-xl bg-brand-navy-dark px-3.5 py-1.5 text-xs font-semibold text-brand-cream shadow-premium border border-white/10 md:group-hover:block transition-all animate-fade-in">
      <span>Chat with Admissions Desk</span>
      <div class="absolute left-full top-1/2 -translate-y-1/2 -ml-1 border-4 border-transparent border-l-brand-navy-dark"></div>
    </div>

    <a
      href="https://wa.me/917259526202?text=Hello%20Sri%20Advaita%20Admissions%20Desk%2C%20I%20would%20like%20to%20know%20more%20about%20admissions%20for%20Academic%20Year%202027-28."
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat with Sri Advaita Admissions on WhatsApp"
      class="flex h-14 w-14 items-center justify-center rounded-full bg-emerald-600 text-white shadow-premium transition-all duration-300 hover:scale-110 hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
    >
      <span class="absolute -top-1 -right-1 flex h-4 w-4">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500 border-2 border-white"></span>
      </span>

      <svg class="h-7 w-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
    </a>
  </div>
</aside>

<!-- Mobile Sticky Bottom Conversion Bar (Phones < 768px only) -->
<nav
  id="mobile-sticky-bar"
  aria-label="Quick Admissions Actions"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-gold/30 bg-brand-navy-dark/95 backdrop-blur-md px-4 py-2.5 shadow-premium md:hidden print:hidden transition-transform duration-300 translate-y-0"
>
  <div class="mx-auto flex max-w-md items-center justify-between gap-3">
    <!-- Call Campus -->
    <a
      href="tel:+917259526202"
      class="flex flex-1 items-center justify-center gap-2 rounded-xl border border-brand-gold/40 bg-brand-navy px-3 py-2.5 text-xs font-bold text-brand-gold-light active:bg-brand-navy-light"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Call Desk</span>
    </a>

    <!-- Admissions 2027–28 -->
    <a
      href="#admissions"
      class="flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-brand-gold px-3 py-2.5 text-xs font-bold text-brand-navy-dark shadow-sm active:bg-brand-gold-light"
    >
      <span>Admissions 2027–28</span>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</nav>

<script>
  // Back to Top button scroll visibility
  const bttBtn = document.getElementById("back-to-top");
  if (bttBtn) {
    const checkScroll = () => {
      if (window.scrollY > 400) {
        bttBtn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
        bttBtn.classList.add("opacity-100", "translate-y-0");
      } else {
        bttBtn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
        bttBtn.classList.remove("opacity-100", "translate-y-0");
      }
    };

    window.addEventListener("scroll", checkScroll, { passive: true });
    bttBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
