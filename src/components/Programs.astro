---
/**
 * Programs.astro — Academic Offerings (Nursery to Grade 8).
 * Minimal, authentic, human-centred presentation without data dumping.
 */
import type { Course } from '../lib/queries';

interface Props {
  courses?: Course[];
}

const { courses = [] } = Astro.props;

const programs = [
  {
    id: "nursery",
    title: "Nursery (Pre-KG)",
    partner: "With Little Elly",
    stageKey: "early-years",
    age: "Ages 2.5 to 3.5 years",
    ratio: "2 adults, 18 children",
    image: "/images/little-elly-nursery.jpg",
    description:
      "The room feels more like home than school. Toddlers start putting words together, find out they have opinions, and spend a lot of time with shapes, textures and music.",
    essentials: [
      "Sensory play and Montessori tactile materials",
      "Songs and rhymes that build early sounds",
      "Scooping, threading and climbing for small and big muscles",
      "Time to settle in at their own pace",
    ],
  },
  {
    id: "lkg",
    title: "Junior KG (LKG)",
    partner: "With Little Elly",
    stageKey: "early-years",
    age: "Ages 3.5 to 4.5 years",
    ratio: "2 adults, 20 children",
    image: "/images/little-elly-lkg.jpg",
    description:
      "This is the year children start speaking up, especially in English. Learning is hands-on: puzzles, blocks and story props, inside a daily routine they come to know by heart.",
    essentials: [
      "Spoken English, phonics and story time",
      "Sorting, counting and spotting patterns",
      "Art, drama and noticing how friends feel",
      "Getting comfortable saying what they think",
    ],
  },
  {
    id: "ukg",
    title: "Senior KG (UKG)",
    partner: "With Little Elly",
    stageKey: "early-years",
    age: "Ages 4.5 to 5.5 years",
    ratio: "2 adults, 20 children",
    image: "/images/little-elly-ukg.jpg",
    description:
      "The last preschool year, with Grade 1 just ahead. Children begin reading simple words, work with numbers, and start doing small tasks on their own.",
    essentials: [
      "Reading and writing readiness",
      "Reasoning with numbers and simple problems",
      "Science corners for the endless 'why' questions",
      "A gradual move into Grade 1",
    ],
  },
  {
    id: "primary",
    title: "Primary School (Grades 1 to 5)",
    partner: "State Board",
    stageKey: "primary",
    age: "Ages 5.5 to 10 years",
    ratio: "1 mentor, 15 children",
    image: "/images/campus-front-view.jpg",
    description:
      "Children follow the State Board syllabus in maths, languages and social studies, with plenty of chances to try ideas out instead of only memorising them.",
    essentials: [
      "Maths and science taught through questions and small experiments",
      "English, Kannada and Tamil in daily use",
      "Sports and yoga every day, with time set aside for values",
      "Progress followed all year, so exams don't turn into dread",
    ],
  },
  {
    id: "middle",
    title: "Middle School (Grades 6 to 8)",
    partner: "State Board",
    stageKey: "middle",
    age: "Ages 10 to 13 years",
    ratio: "1 mentor, 18 students",
    image: "/images/gallery-science.jpg",
    description:
      "The subjects get harder in these years. Students run experiments in the lab, write their first bits of code, and learn to speak up and lead with a sense of fairness.",
    essentials: [
      "Hands-on experiments in the science lab",
      "First steps in coding and logical thinking",
      "Debate, public speaking and group projects",
      "Solid concepts to carry into high school",
    ],
  },
];
---

<section
  id="programs"
  data-programs
  class="relative isolate overflow-hidden bg-brand-navy-dark py-16 text-brand-cream sm:py-20 lg:py-28"
  aria-labelledby="programs-heading"
>
  <div class="pointer-events-none absolute -right-32 top-1/4 -z-10 h-96 w-96 rounded-full bg-brand-gold/10 blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-32 bottom-1/4 -z-10 h-96 w-96 rounded-full bg-brand-navy-light/40 blur-[140px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-gold/40 bg-brand-gold/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-gold-light mb-3">
        Our Classes
      </span>
      <h2
        id="programs-heading"
        class="font-serif text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Where your child grows up: <span class="font-normal italic text-brand-gold-light">Nursery to Grade 8</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-brand-cream/80 sm:text-lg">
        Children begin with Little Elly's play-based early years and move on to our State Board primary and middle school classes. Each year is planned around how a child of that age actually learns.
      </p>
    </header>

    <!-- Little Elly Foundational Collaboration Strip -->
    <div class="mb-12 overflow-hidden rounded-3xl border border-brand-gold/30 bg-gradient-to-r from-brand-navy via-brand-navy-light/90 to-brand-navy p-6 sm:p-8 shadow-xl">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-2 rounded-xl bg-white/10 p-2 border border-white/10">
            <img src="/images/logo-crest.png" alt="Sri Advaita Crest" width="36" height="36" class="h-9 w-9 object-contain" />
            <span class="font-bold text-xs uppercase tracking-wider text-brand-gold-light">Sri Advaita</span>
          </div>
          <span class="font-serif text-xl text-brand-gold">×</span>
          <div class="flex items-center gap-2 rounded-xl bg-white p-2 shadow-sm">
            <img src="/images/little-elly-logo.png" alt="Little Elly Preschool Logo" width="110" height="30" class="h-7 w-auto object-contain" />
          </div>
          <span class="rounded-full border border-brand-gold/40 bg-brand-gold/15 px-3 py-0.5 text-xs font-medium text-brand-gold-light">
            Early Years Wing (Nursery to UKG)
          </span>
        </div>
        <p class="text-xs sm:text-sm text-brand-cream/80 max-w-lg leading-relaxed">
          Little Elly has been running preschools for 20 years and has more than 172 centres across India. Our early years classes follow its mix of Montessori, Steiner and play-based learning.
        </p>
      </div>
    </div>

    <!-- Filter Pills -->
    <div class="mb-10 flex flex-wrap items-center justify-center gap-2.5" data-program-filters>
      <button
        type="button"
        class="filter-pill active rounded-full px-5 py-2 text-xs font-bold transition-all border border-brand-gold bg-brand-gold text-brand-navy-dark shadow-sm"
        data-filter="all"
      >
        All Classes
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="early-years"
      >
        Early Years (Nursery to UKG)
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="primary"
      >
        Primary (Grades 1 to 5)
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="middle"
      >
        Middle School (Grades 6 to 8)
      </button>
    </div>

    <!-- Programs Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {programs.map((p) => (
        <article
          class="card group flex flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-brand-navy/60 p-6 backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-brand-gold/50 hover:shadow-2xl"
          data-stage={p.stageKey}
        >
          <div>
            <!-- Image Thumbnail -->
            <div class="relative mb-5 aspect-[16/10] w-full overflow-hidden rounded-2xl border border-white/10 bg-white/5">
              <img
                src={p.image}
                alt={p.title}
                width="400"
                height="250"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <span class="absolute top-3 left-3 rounded-full bg-brand-navy-dark/90 backdrop-blur-md px-3 py-0.5 text-[10px] font-bold text-brand-gold-light border border-brand-gold/40">
                {p.partner}
              </span>
              <span class="absolute bottom-3 right-3 rounded-full bg-black/70 backdrop-blur-md px-2.5 py-0.5 text-[10px] text-white">
                {p.ratio}
              </span>
            </div>

            <!-- Title & Age -->
            <div class="mb-3 flex items-start justify-between gap-2">
              <h3 class="font-serif text-xl font-bold text-white">{p.title}</h3>
              <span class="rounded-full border border-brand-gold/30 bg-brand-gold/15 px-2.5 py-0.5 text-[11px] font-medium text-brand-gold-light whitespace-nowrap">
                {p.age}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-brand-cream/75 leading-relaxed mb-5">
              {p.description}
            </p>

            <!-- Key Essentials -->
            <ul class="space-y-2 mb-6">
              {p.essentials.map((item) => (
                <li class="flex items-start gap-2 text-xs text-brand-cream/85">
                  <span class="text-brand-gold mt-0.5">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Action -->
          <a
            href="#contact"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-brand-gold/30 bg-white/5 py-3 text-xs font-bold text-brand-gold-light transition hover:bg-brand-gold hover:text-brand-navy"
          >
            Admission Enquiry
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.querySelector('[data-programs]');
  const filterContainer = section?.querySelector('[data-program-filters]');
  const cards = section?.querySelectorAll('.card');

  if (filterContainer && cards) {
    const buttons = filterContainer.querySelectorAll('.filter-pill');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        buttons.forEach((b) => {
          b.classList.remove('active', 'border-brand-gold', 'bg-brand-gold', 'text-brand-navy-dark');
          b.classList.add('border-white/15', 'bg-white/5', 'text-brand-cream/80');
        });
        btn.classList.add('active', 'border-brand-gold', 'bg-brand-gold', 'text-brand-navy-dark');
        btn.classList.remove('border-white/15', 'bg-white/5', 'text-brand-cream/80');

        cards.forEach((card) => {
          const stage = card.getAttribute('data-stage');
          const el = card as HTMLElement;
          if (filter === 'all' || stage === filter) {
            el.style.display = 'flex';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  }
</script>