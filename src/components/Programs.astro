<style>
  /* ---------- Grid: centred flex-wrap with exact column widths ---------- */
  .card-list {
    --gap: 1.5rem;
    gap: var(--gap);
  }
  .card-item {
    width: 100%;
  }
  @media (min-width: 768px) {
    .card-item {
      width: calc((100% - var(--gap)) / 2);
    }
  }
  @media (min-width: 1024px) {
    .card-list {
      --gap: 2rem;
    }
    .card-item {
      width: calc((100% - 2 * var(--gap)) / 3);
    }
  }

  /* ---------- Card ---------- */
  .card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.02));
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease,
      box-shadow 0.35s ease;
  }

  /* Soft glow that follows the pointer (position set by the script) */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--color-brand-gold-light, #d4b36a) 16%, transparent),
      transparent 70%
    );
    transition: opacity 0.3s ease;
  }

  .icon,
  .card-img,
  .arrow {
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
  }

  .card-title {
    transition: color 0.3s ease;
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--color-brand-gold-light, #d4b36a) 45%, transparent);
      box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.7);
    }
    .card:hover::before {
      opacity: 1;
    }
    .card:hover .icon {
      transform: scale(1.08);
      border-color: var(--color-brand-gold, #b38f43);
    }
    .card:hover .card-img {
      transform: scale(1.05);
    }
    .card:hover .card-title {
      color: var(--color-brand-gold-light, #d4b36a);
    }
  }

  .card:hover .arrow,
  .card-link:focus-visible .arrow {
    transform: translateX(4px);
  }

  /* ---------- Callout button ---------- */
  .cta {
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }
  .cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 12px 28px -10px rgb(0 0 0 / 0.6);
  }
  .cta:active {
    transform: translateY(0);
  }

  /* ---------- Entrance: JS adds data-motion, then data-in per item ---------- */
  [data-motion] [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--d, 0) * 90ms);
  }
  [data-motion] [data-reveal][data-in] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card::before,
    .icon,
    .card-img,
    .arrow,
    .cta {
      transition: none;
    }
    .card:hover,
    .card:hover .icon,
    .card:hover .card-img,
    .card:hover .arrow,
    .card-link:focus-visible .arrow,
    .cta:hover {
      transform: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-programs]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Stage Filter Tabs Interactivity
  const filterContainer = section?.querySelector<HTMLElement>('[data-program-filters]');
  const cards = section?.querySelectorAll<HTMLElement>('.card-item');

  if (filterContainer && cards) {
    const buttons = filterContainer.querySelectorAll<HTMLButtonElement>('.filter-pill');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        // Update active button styling
        buttons.forEach((b) => {
          b.classList.remove('active', 'border-brand-gold', 'bg-brand-gold', 'text-brand-navy-dark');
          b.classList.add('border-white/15', 'bg-white/5', 'text-brand-cream/80');
        });
        btn.classList.add('active', 'border-brand-gold', 'bg-brand-gold', 'text-brand-navy-dark');
        btn.classList.remove('border-white/15', 'bg-white/5', 'text-brand-cream/80');

        // Filter cards
        cards.forEach((card) => {
          const cardStage = card.getAttribute('data-stage');
          if (filter === 'all' || cardStage === filter) {
            card.style.display = 'flex';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  if (section && !prefersReduced) {
    // Scroll reveal
    if ('IntersectionObserver' in window) {
      const items = section.querySelectorAll<HTMLElement>('[data-reveal]');
      section.setAttribute('data-motion', '');

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).setAttribute('data-in', '');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );

      items.forEach((item) => observer.observe(item));
    }

    // Pointer glow: one delegated listener for every card (mouse only)
    const list = section.querySelector<HTMLElement>('[data-cards]');
    list?.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const card = (event.target as HTMLElement).closest<HTMLElement>('.card');
      if (!card) return;
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      card.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  }
</script>