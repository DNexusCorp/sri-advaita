---
/**
 * Programs.astro — Courses from Sanity CMS, or the curated academic pathways
 * (with vector icons and curriculum highlights) when the CMS has none.
 *
 * Layout
 *  - Cards sit in a centred flex-wrap grid: 1 column on phones, 2 from md,
 *    3 from lg. A short last row is centred instead of leaving a gap, and
 *    cards in the same row always share one height.
 *  - Every card has the same anatomy (header, title, text, highlights, footer
 *    link) and the footer link is pinned to the bottom, so links line up.
 *
 * Motion: cards fade up once as they scroll into view; on hover a soft gold
 * glow follows the pointer, the card lifts slightly and the arrow nudges.
 * All of it is skipped for reduced-motion users, and nothing is hidden
 * without JavaScript.
 */
import { PortableText } from 'astro-portabletext';
import type { Course } from '../lib/queries';
import { urlForImage } from '../lib/sanity';

interface Props {
  courses: Course[];
}

const { courses = [] } = Astro.props;

// Polished academic offerings with authentic imagery and Little Elly collaboration
