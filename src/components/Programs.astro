const littleEllyPillars = [
  {
    letter: 'H',
    title: 'Healthy Body',
    tag: 'Physical Vitality & Motor Skills',
    description: 'Gross and fine motor skills, wholesome nutrition habits, sensory-motor agility, and joyful active play.',
    icon: '🏃',
  },
  {
    letter: 'A',
    title: 'Awakened Mind',
    tag: 'Curiosity & Sensory Discovery',
    description: 'Cultivating wonder, sensory exploration, early scientific logic, and leaves the classroom full of questions.',
    icon: '🌟',
  },
  {
    letter: 'P',
    title: 'Playful Heart',
    tag: 'Empathy, Joy & Friendships',
    description: 'Emotional resilience, caring for peers, spontaneous laughter, and creative dramatic storytelling.',
    icon: '💖',
  },
  {
    letter: 'P',
    title: 'Purposeful Self',
    tag: 'Independence & Confidence',
    description: 'Dressing, eating, and tidying independently, making thoughtful choices, and expressing their voice.',
    icon: '🌱',
  },
  {
    letter: 'Y',
    title: 'Yearning to Learn',
    tag: 'Lifelong Curiosity & Readiness',
    description: 'A deep, enduring love for discovery, phonics fluency, and walking into Grade 1 completely school-ready.',
    icon: '🚀',
  },
];

const hasCMSData = courses.length > 0;

const focusRing =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-navy-dark';
const arrowPath = 'M14 5l7 7m0 0l-7 7m7-7H3';
---

<section
  id="programs"
  data-programs
  class="relative isolate overflow-hidden bg-brand-navy-dark py-16 text-brand-cream sm:py-20 lg:py-28"
  aria-labelledby="programs-heading"
>
  <!-- Atmospheric background lights -->
  <div class="pointer-events-none absolute -right-32 top-1/4 -z-10 h-96 w-96 rounded-full bg-brand-gold/10 blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-32 bottom-1/4 -z-10 h-96 w-96 rounded-full bg-brand-navy-light/40 blur-[140px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <header class="mx-auto mb-12 max-w-3xl text-center lg:mb-16" data-reveal style="--d:0">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-gold/40 bg-brand-gold/20 px-4 py-1.5 text-sm font-semibold text-brand-gold-light">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-gold/70 motion-reduce:animate-none"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-gold"></span>
        </span>
        Academic Excellence &amp; Early Years Collaboration
      </p>
      <h2
        id="programs-heading"
        class="text-balance font-serif text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        Structured pathways for lifelong learning
      </h2>
      <div class="mx-auto mt-5 h-0.5 w-14 rounded-full bg-gradient-to-r from-brand-gold to-brand-gold-light" aria-hidden="true"></div>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-brand-cream/75 sm:text-lg">
        From Little Elly’s joyful early childhood foundation (Nursery, LKG, UKG) to our rigorous State Board Primary and Middle School STEAM curriculum, we equip every child with lasting conceptual mastery.
      </p>
    </header>

    <!-- Stage Filter Tabs -->
    <div class="mb-10 flex flex-wrap items-center justify-center gap-2.5" data-program-filters>
      <button
        type="button"
        class="filter-pill active rounded-full px-5 py-2 text-xs font-bold transition-all border border-brand-gold bg-brand-gold text-brand-navy-dark shadow-sm"
        data-filter="all"
      >
        All Stages
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="foundational"
      >
        Foundational (Little Elly Nursery – UKG)
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="preparatory"
      >
        Preparatory (Grades 1–5)
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="middle"
      >
        Middle School (Grades 6–8)
      </button>
      <button
        type="button"
        class="filter-pill rounded-full px-5 py-2 text-xs font-bold transition-all border border-white/15 bg-white/5 text-brand-cream/80 hover:border-brand-gold/60 hover:text-white"
        data-filter="enrichment"
      >
        Co-Curricular &amp; Labs
      </button>
    </div>

    <!-- Programs -->
    <ul class="card-list flex flex-wrap justify-center" data-cards>
      {hasCMSData ? (
        courses.map((course, index) => (
          <li class="card-item flex" data-reveal style={`--d:${index % 3}`}>
            <article class="card flex w-full flex-col p-6 sm:p-8">
              {course.featureImage && (
                <div class="mb-6 aspect-video overflow-hidden rounded-2xl bg-white/5">
                  <img
                    src={urlForImage(course.featureImage, 640)}
                    alt={course.featureImage.alt || course.title}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    class="card-img h-full w-full object-cover"
                  />
                </div>
              )}

              <div class="mb-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
                <span class="rounded-full border border-brand-gold/30 bg-brand-gold/20 px-3 py-1 text-xs font-semibold text-brand-gold-light">
                  {course.duration || 'Academic Year'}
                </span>
                <span class="text-xs font-medium text-brand-cream/65">{course.fees || 'Admissions Open'}</span>
              </div>

              <h3 class="card-title text-balance font-serif text-xl font-bold leading-snug text-white sm:text-2xl">
                {course.title}
              </h3>

              <div class="mb-6 mt-3 flex-1 text-sm leading-relaxed text-brand-cream/75 [&_p:last-child]:mb-0 [&_p]:mb-3">
                {course.description && <PortableText value={course.description} />}
              </div>

              <a
                href="#contact"
                class={`card-link flex items-center justify-between gap-3 rounded-sm border-t border-white/10 pt-5 text-sm font-semibold text-brand-gold-light transition-colors duration-300 hover:text-white ${focusRing}`}
              >
                <span>
                  Enquire about admission
                  <span class="sr-only"> for {course.title}</span>
                </span>
                <svg class="arrow h-4 w-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath} />
                </svg>
              </a>
            </article>
          </li>
        ))
      ) : (
        academicPrograms.map((prog, index) => (
          <li class="card-item flex" data-stage={prog.categoryKey} data-reveal style={`--d:${index % 3}`}>
            <article class="card group flex w-full flex-col p-6 sm:p-8">
              <!-- Feature Photo Thumbnail with Partner Badge -->
              {prog.image && (
                <div class="relative mb-5 aspect-[16/10] w-full overflow-hidden rounded-2xl border border-white/10 bg-white/5">
                  <img
                    src={prog.image}
                    alt={prog.title}
                    width="480"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    class="card-img h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  {prog.partnerBadge && (
                    <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full border border-brand-gold/40 bg-brand-navy-dark/90 px-3 py-1 text-[11px] font-bold text-brand-gold-light shadow-md backdrop-blur-md">
                      <span class="h-1.5 w-1.5 rounded-full bg-brand-gold animate-pulse"></span>
                      {prog.partnerBadge}
                    </span>
                  )}
                  {prog.ratio && (
                    <span class="absolute bottom-3 right-3 rounded-full bg-black/60 backdrop-blur-md px-2.5 py-0.5 text-[10px] font-medium text-white/90">
                      {prog.ratio}
                    </span>
                  )}
                </div>
              )}

              <!-- Header: icon, duration and age -->
              <div class="mb-5 flex items-start justify-between gap-4">
                <div class="icon flex h-11 w-11 flex-none items-center justify-center rounded-2xl border border-brand-gold/30 bg-gradient-to-br from-brand-gold/25 to-brand-gold/5 text-brand-gold-light">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={prog.iconPath} />
                  </svg>
                </div>
                <div class="min-w-0 text-right">
                  <span class="inline-block rounded-full border border-brand-gold/30 bg-brand-gold/20 px-3 py-1 text-xs font-semibold text-brand-gold-light">
                    {prog.duration}
                  </span>
                  <p class="mt-1 text-xs text-brand-cream/65">{prog.age}</p>
                </div>
              </div>

              <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-brand-gold">{prog.stage}</p>
              <h3 class="card-title text-balance font-serif text-xl font-bold leading-snug text-white sm:text-2xl">
                {prog.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-brand-cream/75">
                {prog.description}
              </p>

              <ul class="mt-6 flex-1 space-y-2.5">
                {prog.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-brand-cream/85">
                    <svg class="mt-0.5 h-4 w-4 flex-none text-brand-gold" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <a
                href="#contact"
                class={`card-link mt-6 flex items-center justify-between gap-3 rounded-sm border-t border-white/10 pt-5 text-sm font-semibold text-brand-gold-light transition-colors duration-300 hover:text-white ${focusRing}`}
              >
                <span>
                  Enquire for 2027–28 session
                  <span class="sr-only"> for {prog.title}</span>
                </span>
                <svg class="arrow h-4 w-4 flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath} />
                </svg>
              </a>
            </article>
          </li>
        ))
      )}
    </ul>

    <!-- Little Elly Early Learning Collaboration Showcase -->
    <div
      class="mt-16 overflow-hidden rounded-3xl border border-brand-gold/40 bg-gradient-to-br from-brand-navy via-brand-navy-light/95 to-brand-navy p-7 text-white shadow-2xl shadow-black/50 sm:p-10 lg:p-12 relative"
      data-reveal
      style="--d:0"
    >
      <!-- Subtle watermark background glow -->
      <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full bg-brand-gold/15 blur-3xl" aria-hidden="true"></div>
      
      <!-- Top Bar: Co-Branded Badging + Mascot -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 border-b border-white/10">
        <div class="flex flex-wrap items-center gap-4 sm:gap-6">
          <div class="flex items-center gap-3 rounded-2xl bg-white/10 p-2.5 backdrop-blur-md border border-white/15">
            <img
              src="/images/logo-crest.png"
              alt="Sri Advaita Educational Trust Crest"
              width="44"
              height="44"
              class="h-11 w-11 object-contain"
            />
            <div class="text-left">
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-gold-light">Sri Advaita</span>
              <span class="text-[10px] text-white/70">Educational Trust</span>
            </div>
          </div>

          <span class="font-serif text-2xl font-light text-brand-gold">×</span>

          <div class="flex items-center gap-3 rounded-2xl bg-white p-2.5 shadow-md">
            <img
              src="/images/little-elly-logo.png"
              alt="Little Elly — India's H.A.P.P.Y. Preschool Logo"
              width="130"
              height="40"
              class="h-9 w-auto object-contain"
            />
          </div>

          <div class="hidden sm:inline-flex items-center gap-2 rounded-full border border-brand-gold/40 bg-brand-gold/15 px-3.5 py-1 text-xs font-semibold text-brand-gold-light">
            <span class="h-2 w-2 rounded-full bg-brand-gold"></span>
            Official Foundational Collaboration
          </div>
        </div>

        <div class="flex items-center gap-3">
          <img
            src="/images/little-elly-peek.png"
            alt="Little Elly Mascot"
            width="55"
            height="55"
            class="h-12 w-auto object-contain"
          />
          <div class="text-left">
            <span class="block text-xs font-bold text-white">20 Years of Joy</span>
            <span class="text-[11px] text-brand-cream/70">172+ Centres in 19 Cities</span>
          </div>
        </div>
      </div>

      <!-- Main Headline & Philosophy -->
      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-gold-light mb-2">
            The Early Years Are Not A Warm-Up. They Are The Main Event.
          </span>
          <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight text-white text-balance">
            Nursery to UKG Powered by the Signature <span class="text-brand-gold-light">H.A.P.P.Y.</span> Curriculum
          </h3>
          <p class="mt-4 text-sm sm:text-base leading-relaxed text-brand-cream/80">
            90% of a child’s brain architecture is built before age six. Through our academic collaboration with <strong>Little Elly</strong>, Sri Advaita brings India’s premier early-years methodology right to Hosur. We blend Montessori hands-on independence, Steiner imagination and music, and play-based inquiry inside secure, loving classrooms.
          </p>
          <blockquote class="mt-4 border-l-2 border-brand-gold pl-4 text-xs sm:text-sm italic text-brand-gold-light font-medium">
            “A happy child isn’t a lucky accident. It’s the method.”
          </blockquote>
        </div>

        <div class="lg:col-span-5 grid grid-cols-2 gap-3.5">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
            <span class="text-xl">🧩</span>
            <h4 class="mt-2 text-sm font-bold text-white">Montessori</h4>
            <p class="mt-1 text-xs text-brand-cream/70 leading-relaxed">Self-direction, tactile sensorial sets, and prepared environments.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
            <span class="text-xl">🎨</span>
            <h4 class="mt-2 text-sm font-bold text-white">Steiner</h4>
            <p class="mt-1 text-xs text-brand-cream/70 leading-relaxed">Imagination, rhythm, nature, storytelling, music, and daily warmth.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm">
            <span class="text-xl">🏃</span>
            <h4 class="mt-2 text-sm font-bold text-white">Play-Based</h4>
            <p class="mt-1 text-xs text-brand-cream/70 leading-relaxed">Child-led inquiry, social discovery, sand play, and motor joy.</p>
