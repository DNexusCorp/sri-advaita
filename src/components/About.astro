---
/**
 * About.astro — School philosophy and heritage section blending
 * Advaita wisdom with modern education, campus photography,
 * the 3 core foundations, and the 6 Core Pillars of Sri Advaita.
 */

const foundations = [
  {
    emoji: "🌱",
    title: "Holistic Growth",
    description: "Mind, body, character, and knowledge harmoniously unified.",
  },
  {
    emoji: "💡",
    title: "Innovative Learning",
    description:
      "Learning through exploration, experiential science, and discovery.",
  },
  {
    emoji: "🤝",
    title: "Strong Values",
    description:
      "Rooted in respect, responsibility, empathy, and social compassion.",
  },
  {
    emoji: "🐘",
    title: "Little Elly Early Years",
    description:
      "Nursery–UKG wing powered by Little Elly's joyful H.A.P.P.Y. curriculum.",
  },
];

const corePillars = [
  {
    title: "Inspire Curiosity",
    subtitle: "Wonder & Exploration",
    description:
      "Encouraging children to question, explore, and discover the wonder in everything around them through inquiry-driven learning.",
    image: "/images/pillar-curiosity.jpg",
    iconPath:
      "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  },
  {
    title: "Encourage Creativity",
    subtitle: "Art, Imagination & Design",
    description:
      "Providing expansive outlets for imagination, artistic expression, original thinking, and structural problem-solving.",
    image: "/images/pillar-creativity.jpg",
    iconPath:
      "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
  },
  {
    title: "Build Confidence",
    subtitle: "Self-Esteem & Expression",
    description:
      "Nurturing high self-esteem, robust public expression, emotional resilience, and independent decision-making abilities.",
    image: "/images/pillar-confidence.jpg",
    iconPath:
      "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  {
    title: "Promote Discipline",
    subtitle: "Ethics, Respect & Habits",
    description:
      "Blending traditional ethics and mutual respect to anchor structured focus, mindfulness, and strong daily habits.",
    image: "/images/pillar-discipline.jpg",
    iconPath:
      "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  },
  {
    title: "Develop Leadership",
    subtitle: "Collaboration & Vision",
    description:
      "Fostering collaborative team dynamics, organizational vision, empathy, and accountability across student initiatives.",
    image: "/images/pillar-leadership.jpg",
    iconPath:
      "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    title: "Foster Lifelong Learning",
    subtitle: "Continuous Knowledge Quest",
    description:
      "Instilling a timeless, self-motivated quest for knowledge that extends far beyond regular examinations into everyday life.",
    image: "/images/pillar-lifelong.jpg",
    iconPath:
      "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
  },
];

const stats = [
  { label: "Holistic Development", count: 100, suffix: "%" },
  { label: "Trained Educators", count: 50, suffix: "+" },
  { label: "Student-Mentor Ratio", value: "1:15" },
];
---

<section
  id="about"
  class="relative overflow-hidden bg-brand-cream py-16 text-brand-navy tab:py-24 lg:py-32"
  aria-labelledby="about-heading"
>
  <div class="mx-auto w-full max-w-7xl px-4 tab-sm:px-6 lg:px-8">
    <!-- Heading + intro -->
    <div
      class="mb-12 grid gap-5 lg:mb-20 lg:grid-cols-12 lg:items-end lg:gap-12"
    >
      <div class="lg:col-span-7">
        <span
          class="text-brand-gold-dark text-xs font-bold uppercase tracking-[0.22em] block mb-3"
        >
          About Sri Advaita
        </span>
        <h2
          id="about-heading"
          class="reveal font-serif text-3xl font-bold leading-[1.1] tracking-tight text-balance text-brand-navy tab-sm:text-4xl lg:text-5xl"
        >
          Rooted in Values. <span
            class="font-normal italic text-brand-gold-dark"
            >Ready for the Future.</span
          >
        </h2>
      </div>
      <p
        class="reveal max-w-prose text-base leading-relaxed text-brand-navy/75 lg:col-span-5 lg:text-lg"
      >
        Sri Advaita Educational Trust (R) creates a joyful, safe, and inspiring
        learning environment where every child discovers their unique potential
        through value-based pedagogy and future-ready experiential exploration.
      </p>
    </div>

    <!-- Campus Photo + Philosophy & Purpose Block -->
    <div class="mb-16 grid gap-10 lg:mb-24 lg:grid-cols-12 lg:gap-12">
      <!-- Left Column: Campus Photo + Foundations -->
      <div class="reveal-left flex flex-col gap-6 lg:col-span-6">
        <figure
          class="photo-frame-premium group relative flex w-full flex-col overflow-hidden rounded-3xl bg-brand-navy-dark shadow-xl"
        >
          <div class="relative aspect-[16/10] w-full overflow-hidden">
            <img
              src="/images/campus-front-view.jpg"
              alt="Sri Advaita Educational Trust campus in Mookandapalli, Hosur"
              width="600"
              height="375"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-navy/80 via-transparent to-transparent"
              aria-hidden="true"
            >
            </div>
          </div>

          <figcaption
            class="flex flex-wrap items-center justify-between gap-3 border-t border-brand-gold/30 bg-brand-navy-dark/95 p-5 text-brand-cream"
          >
            <div>
              <p class="font-serif text-lg font-bold text-brand-gold-light">
                Mookandapalli Campus
              </p>
              <p class="text-xs text-brand-cream/80">
                MGR Nagar, Hosur — Safe, Serene & Green
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="rounded-full border border-brand-gold/40 bg-brand-gold/25 px-3 py-1 text-xs font-semibold text-brand-gold-light"
              >
                Little Elly Wing
              </span>
              <span
                class="rounded-full border border-brand-gold/30 bg-brand-gold/20 px-3 py-1 text-xs font-semibold text-brand-gold-light"
              >
                Est. 2010
              </span>
            </div>
          </figcaption>
        </figure>

        <!-- 4 Core Foundations -->
        <div class="grid gap-3 grid-cols-2 sm:grid-cols-4">
          {
            foundations.map((f) => (
              <div class="rounded-2xl border border-slate-200/80 bg-white p-3.5 shadow-sm transition hover:shadow-md">
                <span class="text-2xl mb-1.5 block">{f.emoji}</span>
                <h3 class="font-bold text-brand-navy text-xs sm:text-sm">{f.title}</h3>
                <p class="text-[11px] sm:text-xs text-slate-600 mt-1 leading-snug">
                  {f.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right Column: Purpose Card + Slogan & Stats -->
      <div
        class="reveal-right flex flex-col justify-between gap-6 lg:col-span-6"
      >
        <div class="rounded-3xl bg-brand-navy p-8 text-white shadow-xl sm:p-10">
          <span
            class="text-brand-gold-light text-xs font-bold uppercase tracking-[0.2em] block mb-2"
          >
            Our Purpose
          </span>
          <h3
            class="font-serif text-2xl sm:text-3xl font-bold text-white mb-6 leading-tight"
          >
            To help every child become their best self.
          </h3>

          <div class="space-y-5 text-slate-300">
            <div>
              <h4
                class="text-white font-bold text-sm tracking-wide uppercase mb-1"
              >
                Our Vision
              </h4>
              <p class="text-sm leading-relaxed text-slate-300">
                To inspire confident, compassionate, and lifelong learners who
                contribute positively to society.
              </p>
            </div>
            <div>
              <h4
                class="text-white font-bold text-sm tracking-wide uppercase mb-1"
              >
                Our Mission
              </h4>
              <p class="text-sm leading-relaxed text-slate-300">
                To provide a balanced educational experience that combines
                academic learning, creativity, technology, physical well-being,
                and value-based development.
              </p>
            </div>
            <div
              class="pt-4 border-t border-white/10 flex items-center justify-between gap-4"
            >
              <div>
                <p
                  lang="kn"
                  class="font-kannada text-brand-gold-light text-xl font-bold"
                >
                  ಹಳೆ ಬೇರು, ಹೊಸ ಚಿಗುರು
                </p>
                <p
                  class="text-xs text-slate-400 mt-0.5 tracking-wider uppercase font-medium"
                >
                  Old Roots. New Shoots.
                </p>
              </div>
              <span class="text-3xl opacity-40">🪷</span>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <dl
          class="grid grid-cols-3 gap-4 rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm"
        >
          {
            stats.map((stat) => (
              <div class="flex flex-col-reverse justify-end gap-1 text-center sm:text-left">
                <dt class="text-xs font-medium leading-snug text-slate-500">
                  {stat.label}
                </dt>
                <dd class="font-serif text-2xl font-bold text-brand-navy tab-sm:text-3xl">
                  {stat.count ? (
                    <span
                      class="counter-value"
                      data-count={stat.count}
                      data-suffix={stat.suffix}
                    >
                      {stat.count}
                      {stat.suffix}
                    </span>
                  ) : (
                    stat.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- The 6 Pillars of Sri Advaita with Images -->
    <div>
      <div class="mb-10 text-center max-w-3xl mx-auto">
        <span
          class="text-brand-gold-dark font-semibold tracking-wider text-xs uppercase block mb-2"
          >Our Foundation</span
        >
        <h3
          class="reveal font-serif text-2xl font-bold text-balance text-brand-navy tab-sm:text-3xl lg:text-4xl"
        >
          Core Pillars of Our Mission
        </h3>
        <p
          class="reveal mx-auto mt-3 max-w-prose text-base leading-relaxed text-brand-navy/75"
        >
          Developing responsible, compassionate, and confident citizens through
          personalized growth paths.
        </p>
      </div>

      <div class="reveal-stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          corePillars.map((pillar) => (
            <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-gold/50 hover:shadow-lg">
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-100">
                <img
                  src={pillar.image}
                  alt={pillar.title}
                  width="360"
                  height="225"
                  class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy-dark/70 via-transparent to-transparent opacity-60" />
                <div class="absolute bottom-3 left-3 flex items-center gap-2 text-white">
                  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-gold/90 text-brand-navy">
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.2"
                        d={pillar.iconPath}
                      />
                    </svg>
                  </span>
                  <span class="text-xs font-semibold tracking-wider uppercase text-brand-gold-light">
                    {pillar.subtitle}
                  </span>
                </div>
              </div>

              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <h4 class="font-serif text-lg font-bold text-brand-navy mb-2">
                    {pillar.title}
                  </h4>
                  <p class="text-sm leading-relaxed text-slate-600">
                    {pillar.description}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
