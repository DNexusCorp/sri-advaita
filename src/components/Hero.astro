---
/**
 * Hero.astro — Full-viewport school hero with a four-slide auto-advancing
 * carousel (copy and photography change together), persistent admissions
 * actions, and an integrated stats band.
 *
 * Carousel behaviour
 *  - Advances every `slideMs`. The active dot's progress bar IS the timer
 *    (CSS animation; JS advances on `animationend`), so pausing is just
 *    pausing the animation.
 *  - Pauses on hover, keyboard focus, when scrolled off-screen, when the tab
 *    is hidden, and via an explicit pause button (WCAG 2.2.2).
 *  - Prev/next buttons, dot navigation, arrow keys and touch swipe.
 *  - Reduced-motion users get no autoplay and no transitions.
 *  - Without JavaScript the first slide is shown and the controls are hidden.
 *
 * Layout
 *  - Slide copy is stacked in a single grid cell, so the column is always as
 *    tall as the longest slide and nothing jumps when slides change.
 *  - Below `sm` the floating badges sit under the photo instead of covering it.
 */

const slideMs = 6500;

const slides = [
  {
    label: "Welcome",
    headline: "Nurturing Young Minds, Building Future Leaders",
    body: "At Sri Advaita Educational Trust, we believe every child is unique and deserves an environment that encourages curiosity, creativity, confidence, and character. Inspired by the philosophy of Advaita (Oneness), our school blends traditional values with modern education to create lifelong learners.",
    image: "/images/campus-building.jpg",
    alt: "Sri Advaita Educational Trust campus building in Mookandapalli, Hosur",
  },
  {
    label: "Little Elly Early Years",
    headline: "Nursery to UKG in Collaboration with Little Elly",
    body: "Enrolment is open for Nursery, LKG, UKG (powered by Little Elly's joyful H.A.P.P.Y. preschool curriculum) and State Board Grades 1 through 8. Early registration is recommended, and our admissions desk is happy to walk you through every step.",
    image: "/images/little-elly-hero.jpg",
    alt: "Joyful early childhood learning and sensory play in the Little Elly wing at Sri Advaita",
  },
  {
    label: "STEM and innovation",
    headline: "Where curiosity gets its hands on real science",
    body: "From the Robotics and Composite Science Lab to guided experiments in every grade, students learn by building, testing, and asking better questions.",
    image: "/images/gallery-science.jpg",
    alt: "Students running a guided experiment in the robotics and composite science lab",
  },
  {
    label: "Arts and culture",
    headline: "Heritage, music, and movement in every school year",
    body: "Bharatanatyam, classical music, and festival celebrations keep Indian traditions alive alongside a modern, experiential curriculum.",
    image: "/images/gallery-cultural.jpg",
    alt: "Students performing a classical Indian dance on the school stage",
  },
];

const highlights = [
  "Little Elly Early Years (Nursery–UKG)",
  "State Board Academic Stream",
  "Safe, CCTV-Protected Green Campus",
];

// `count` marks values that count up on scroll; the ratio stays static.
const stats = [
  {
    value: "15+",
    count: 15,
    suffix: "+",
    label: "Years of Trust & Excellence",
  },
  { value: "1:15", label: "Teacher-to-Student Ratio" },
  {
    value: "100%",
    count: 100,
    suffix: "%",
    label: "Academic Excellence",
  },
  { value: "5+", count: 5, suffix: "+", label: "Acres Green Campus" },
];

const focusRing =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-navy-dark";
const ctrlBtn = `flex h-10 w-10 flex-none items-center justify-center rounded-full border border-brand-gold/30 text-brand-cream transition-colors duration-300 hover:border-brand-gold hover:bg-brand-gold/10 hover:text-brand-gold-light ${focusRing}`;
---

<section
  id="home"
  data-hero
  style={`--slide-ms:${slideMs}ms`}
  class="hero-section relative isolate flex min-h-[92svh] flex-col justify-start overflow-hidden bg-gradient-to-b from-brand-navy-dark via-brand-navy to-brand-navy-dark text-brand-cream"
  aria-label="Welcome to Sri Advaita Educational Trust"
>
  <!-- Ambient lighting (static) -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute -right-24 -top-32 h-72 w-72 rounded-full bg-brand-gold opacity-25 blur-[100px] sm:h-[500px] sm:w-[500px] lg:h-[600px] lg:w-[600px] lg:blur-[120px]"
    >
    </div>
    <div
      class="absolute -left-32 top-1/2 h-72 w-72 rounded-full bg-brand-navy-light opacity-40 blur-[110px] sm:h-[420px] sm:w-[420px]"
    >
    </div>
    <div
      class="absolute bottom-10 right-1/4 hidden h-[360px] w-[360px] rounded-full bg-brand-gold-light opacity-10 blur-[100px] lg:block"
    >
    </div>
    <div class="arch-grid absolute inset-0"></div>
  </div>

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Carousel region: copy, imagery and controls move together -->
    <div
      data-stage
      role="region"
      aria-roledescription="carousel"
      aria-label="Featured highlights"
      class="grid items-center gap-12 lg:grid-cols-12 lg:gap-12"
    >
      <!-- Left: copy -->
      <div class="min-w-0 space-y-7 text-center lg:col-span-7 lg:text-left">
        <div
          class="intro mb-3 sm:mb-4 flex justify-center lg:justify-start"
          style="--i:0"
        >
          <p
            class="inline-flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 rounded-full border border-brand-gold/35 bg-brand-navy-dark/90 px-4 py-2 backdrop-blur-md shadow-md ring-1 ring-brand-gold/20"
          >
            <span
              class="h-2 w-2 flex-none animate-pulse rounded-full bg-brand-gold motion-reduce:animate-none"
              aria-hidden="true"></span>
            <span
              lang="kn"
              class="font-kannada text-xs sm:text-sm font-semibold tracking-wide text-brand-gold-light"
              >ಹಳೆ ಬೇರು, ಹೊಸ ಚಿಗುರು</span
            >
            <span class="text-xs text-brand-cream/35" aria-hidden="true">|</span
            >
            <span
              lang="en"
              class="text-xs sm:text-sm font-medium text-brand-cream/90"
              >Old Roots. New Shoots.</span
            >
          </p>
        </div>

        <!-- Slide copy: all slides share one grid cell so height never changes -->
        <div class="intro grid" style="--i:1" aria-live="off" data-live>
          {
            slides.map((slide, i) => {
              const Heading = i === 0 ? "h1" : "h2";
              return (
                <div
                  data-slide={i}
                  data-active={i === 0 ? "" : undefined}
                  inert={i !== 0}
                  aria-hidden={i === 0 ? "false" : "true"}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${slides.length}: ${slide.label}`}
                  class="slide-copy col-start-1 row-start-1 min-w-0"
                >
                  <Heading class="text-balance font-serif text-3xl font-bold leading-[1.15] tracking-tight text-white sm:text-5xl lg:text-6xl">
                    {slide.headline}
                  </Heading>
                  <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-brand-cream/80 sm:text-lg lg:mx-0">
                    {slide.body}
                  </p>
                </div>
              );
            })
          }
        </div>

        <!-- Persistent highlights -->
        <ul
          class="intro flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 lg:justify-start"
          style="--i:2"
        >
          {
            highlights.map((item) => (
              <li class="inline-flex items-center gap-2 text-sm font-medium text-brand-cream/85">
                <svg
                  class="h-4 w-4 flex-none text-brand-gold"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>

        <!-- Persistent actions -->
        <div
          class="intro flex flex-col items-stretch justify-center gap-3.5 pt-1 sm:flex-row sm:items-center lg:justify-start"
          style="--i:3"
        >
          <a
            href="#admissions"
            class={`group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full bg-gradient-to-r from-brand-gold via-brand-gold-light to-brand-gold px-7 py-3.5 text-base font-bold text-brand-navy shadow-lg shadow-brand-gold/30 transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-brand-gold/40 active:translate-y-0 motion-reduce:transition-none motion-reduce:hover:translate-y-0 ${focusRing}`}
          >
            <span class="relative z-10 inline-flex items-center gap-2">
              Admissions 2027–28
              <svg
                class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </span>
            <span
              class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/35 to-transparent transition-transform duration-700 group-hover:translate-x-full motion-reduce:hidden"
              aria-hidden="true"></span>
          </a>

          <a
            href="#contact"
            class={`group inline-flex items-center justify-center gap-2 rounded-full border border-brand-gold/40 px-6 py-3.5 text-base font-semibold text-brand-cream transition-colors duration-300 hover:border-brand-gold hover:bg-brand-gold/10 hover:text-brand-gold-light ${focusRing}`}
          >
            <svg
              class="h-4 w-4 text-brand-gold"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            Book Campus Tour
          </a>

          <a
            href="#programs"
            class={`group inline-flex items-center justify-center gap-1.5 rounded-full px-4 py-3 text-sm font-medium text-brand-cream/80 hover:text-brand-gold-light transition-colors ${focusRing}`}
          >
            Explore programs
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: imagery, badges, controls -->
      <div
        class="intro mx-auto w-full min-w-0 max-w-lg lg:col-span-5 lg:max-w-none"
        style="--i:2"
      >
        <div class="relative">
          <!-- Photo frame -->
          <div
            class="rounded-[1.75rem] bg-gradient-to-br from-brand-gold/70 via-brand-gold/10 to-brand-gold/50 p-[3px] shadow-2xl shadow-black/40"
          >
            <div
              class="relative aspect-[4/3] overflow-hidden rounded-[1.5rem] bg-brand-navy"
            >
              {
                slides.map((slide, i) => (
                  <div
                    data-slide={i}
                    data-active={i === 0 ? "" : undefined}
                    inert={i !== 0}
                    aria-hidden="true"
                    class="slide-media absolute inset-0"
                  >
                    <img
                      src={slide.image}
                      alt={slide.alt}
                      width="800"
                      height="600"
                      loading={i === 0 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : "auto"}
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                ))
              }
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-navy-dark/70 via-transparent to-transparent"
                aria-hidden="true"
              >
              </div>
            </div>
          </div>

          <!-- Badges: stacked under the photo on phones, floating on the photo from sm up.
               `sm:contents` lets them position against the frame wrapper. -->
          <div class="mt-4 flex flex-wrap justify-center gap-3 sm:contents">
            <div
              class="z-20 flex items-center gap-3 rounded-2xl border border-brand-gold/40 bg-brand-navy-dark/95 px-4 py-2.5 shadow-2xl backdrop-blur-xl sm:absolute sm:left-4 sm:top-4 lg:-left-4 lg:top-2"
            >
              <div
                class="flex h-9 w-9 flex-none items-center justify-center rounded-xl bg-brand-gold/20 text-brand-gold"
              >
                <svg
                  class="h-5 w-5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                  ></path>
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-brand-gold-light">
                  Top-Ranked
                </p>
                <p class="text-xs font-medium text-brand-cream/70">
                  State Board School in Hosur
                </p>
              </div>
            </div>

            <div
              class="z-20 flex items-center gap-3 rounded-2xl border border-emerald-500/40 bg-brand-navy-dark/95 px-4 py-2.5 shadow-2xl backdrop-blur-xl sm:absolute sm:bottom-4 sm:right-4 lg:-bottom-5 lg:-right-5"
            >
              <span class="relative flex h-3 w-3 flex-none" aria-hidden="true">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400/70 motion-reduce:animate-none"
                ></span>
                <span
                  class="relative inline-flex h-3 w-3 rounded-full bg-emerald-400"
                ></span>
              </span>
              <div>
                <p class="text-xs font-bold text-white">Admissions 2027–28</p>
                <p class="text-xs font-medium text-emerald-300">
                  Open for Pre-KG to Grade 8
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Carousel controls (shown only when JavaScript is running) -->
        <div
          class="controls mt-8 flex-wrap items-center justify-center gap-3 lg:justify-start"
          data-controls
        >
          <button
            type="button"
            data-prev
            class={ctrlBtn}
            aria-label="Previous slide"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>

          <div
            class="flex items-center"
            role="group"
            aria-label="Choose a slide"
          >
            {
              slides.map((slide, i) => (
                <button
                  type="button"
                  data-dot={i}
                  aria-current={i === 0 ? "true" : "false"}
                  aria-label={`Go to slide ${i + 1}: ${slide.label}`}
                  class={`dot flex h-10 items-center rounded-full px-1 ${focusRing}`}
                >
                  <span class="track relative block h-1.5 overflow-hidden rounded-full bg-white/25">
                    <span class="fill absolute inset-0 origin-left rounded-full bg-brand-gold" />
                  </span>
                </button>
              ))
            }
          </div>

          <button
            type="button"
            data-next
            class={ctrlBtn}
            aria-label="Next slide"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </button>

          <button
            type="button"
            data-pause
            class={`pause-btn ${ctrlBtn}`}
            aria-label="Pause slide show"
          >
            <svg
              class="icon-pause h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M7 5h3.5v14H7V5zm6.5 0H17v14h-3.5V5z"></path>
            </svg>
            <svg
              class="icon-play h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M8 5.5v13a1 1 0 001.52.85l10.4-6.5a1 1 0 000-1.7L9.52 4.65A1 1 0 008 5.5z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Stats band: one panel with hairline dividers -->
    <dl
      class="intro mt-10 sm:mt-12 lg:mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-brand-gold/20 bg-brand-gold/20 md:grid-cols-4"
      style="--i:5"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col-reverse items-center justify-center bg-brand-navy px-4 py-6 text-center transition-colors duration-300 hover:bg-brand-navy-light sm:py-8">
            <dt class="mt-1.5 max-w-[16ch] text-balance text-xs font-medium text-brand-cream/70 sm:max-w-none sm:text-sm">
              {stat.label}
            </dt>
            <dd class="font-serif text-3xl font-bold tabular-nums text-brand-gold sm:text-4xl">
              <span
                aria-hidden="true"
                data-count={stat.count}
                data-suffix={stat.suffix}
              >
                {stat.value}
              </span>
              <span class="sr-only">{stat.value}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* ---------- Hero section navbar clearance & responsive padding ---------- */
  .hero-section {
    padding-top: calc(var(--nav-h, 6.75rem) + 2.5rem);
    padding-bottom: 3.5rem;
  }

  @media (min-width: 40rem) {
    .hero-section {
      padding-top: calc(var(--nav-h, 6.75rem) + 3.25rem);
      padding-bottom: 4rem;
    }
  }

  @media (min-width: 64rem) {
    .hero-section {
      padding-top: calc(var(--nav-h, 7.25rem) + 4.25rem);
      padding-bottom: 4.5rem;
    }
  }

  /* ---------- Decorative grid, faded toward the edges ---------- */
  .arch-grid {
    opacity: 0.05;
    background-image:
      linear-gradient(rgba(212, 179, 106, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212, 179, 106, 0.5) 1px, transparent 1px);
    background-size: 50px 50px;
    -webkit-mask-image: radial-gradient(
      ellipse at 70% 30%,
      #000,
      transparent 70%
    );
    mask-image: radial-gradient(ellipse at 70% 30%, #000, transparent 70%);
  }

  /* ---------- Page-load entrance (one staggered sequence) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .intro {
      animation: intro 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i, 0) * 100ms);
    }
  }
  @keyframes intro {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Slides ---------- */
  .slide-copy {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.6s;
  }
  .slide-copy[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    /* wait briefly so the outgoing slide clears first */
    transition-delay: 0.15s, 0.15s, 0s;
  }

  .slide-media {
    opacity: 0;
    visibility: hidden;
    transform: scale(1.05);
    transition:
      opacity 0.9s ease,
      transform 1.6s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.9s;
  }
  .slide-media[data-active] {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition-delay: 0s;
  }

  /* Photo always fills the frame exactly, even if a global `img { height: auto }`
     rule exists elsewhere in the project (scoped CSS outranks it). */
  .slide-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* ---------- Controls ---------- */
  .controls {
    display: none;
  }
  [data-js] .controls {
    display: flex;
  }

  .dot .track {
    width: 0.5rem;
    transition:
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease;
  }
  .dot:hover .track {
    background-color: rgba(255, 255, 255, 0.45);
  }
  .dot[aria-current="true"] .track {
    width: 2.75rem;
  }

  /* The active dot's fill is the autoplay timer */
  .fill {
    transform: scaleX(0);
  }
  .dot[aria-current="true"] .fill {
    animation: progress var(--slide-ms, 6500ms) linear forwards;
  }
  [data-halt] .dot[aria-current="true"] .fill {
    animation-play-state: paused;
  }
  @keyframes progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .icon-play {
    display: none;
  }
  [data-user-paused] .icon-pause {
    display: none;
  }
  [data-user-paused] .icon-play {
    display: block;
  }

  /* ---------- Reduced motion: no autoplay, no slide movement ---------- */
  [data-reduced] .pause-btn {
    display: none;
  }
  [data-reduced] .dot[aria-current="true"] .fill {
    animation: none;
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .slide-copy,
    .slide-media,
    .dot .track {
      transition: none;
    }
    .slide-copy,
    .slide-media {
      transform: none;
    }
    .dot[aria-current="true"] .fill {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-hero]");

  if (root) {
    root.setAttribute("data-js", "");

    const duration = 6500;
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const live = root.querySelector<HTMLElement>("[data-live]")!;
    const slideEls = Array.from(
      root.querySelectorAll<HTMLElement>("[data-slide]"),
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-dot]"),
    );
    const pauseBtn = root.querySelector<HTMLButtonElement>("[data-pause]")!;
    const total = dots.length;

    let index = 0;
    let userPaused = reduced;
    let hovering = false;
    let focused = false;
    let offscreen = false;

    let timerId: ReturnType<typeof setTimeout> | null = null;
    let slideStartTime = Date.now();
    let elapsedMs = 0;

    if (reduced) {
      root.setAttribute("data-reduced", "");
      root.setAttribute("data-user-paused", "");
    }

    const isHalted = () => {
      return (
        userPaused ||
        hovering ||
        focused ||
        offscreen ||
        document.hidden ||
        document.documentElement.classList.contains("is-loading")
      );
    };

    const clearSlideTimer = () => {
      if (timerId !== null) {
        clearTimeout(timerId);
        timerId = null;
      }
    };

    const pauseAutoplay = () => {
      if (timerId !== null) {
        clearSlideTimer();
        elapsedMs += Date.now() - slideStartTime;
      }
      root.setAttribute("data-halt", "");
    };

    const scheduleNextSlide = (ms = duration) => {
      clearSlideTimer();
      elapsedMs = 0;
      slideStartTime = Date.now();
      if (isHalted()) {
        root.setAttribute("data-halt", "");
        return;
      }
      root.removeAttribute("data-halt");
      timerId = setTimeout(() => {
        go(index + 1);
      }, ms);
    };

    const resumeAutoplay = () => {
      if (isHalted()) return;
      root.removeAttribute("data-halt");
      const remaining = duration - elapsedMs;
      if (remaining <= 200) {
        go(index + 1);
      } else {
        slideStartTime = Date.now();
        clearSlideTimer();
        timerId = setTimeout(() => {
          go(index + 1);
        }, remaining);
      }
    };

    const sync = () => {
      const halted = isHalted();
      root.toggleAttribute("data-halt", halted);
      root.toggleAttribute("data-user-paused", userPaused);
      live.setAttribute("aria-live", userPaused ? "polite" : "off");
      pauseBtn.setAttribute(
        "aria-label",
        userPaused ? "Play slide show" : "Pause slide show",
      );

      if (halted) {
        pauseAutoplay();
      } else {
        resumeAutoplay();
      }
    };

    const resetDotAnimation = (activeDotIndex: number) => {
      dots.forEach((dot, i) => {
        const isActive = i === activeDotIndex;
        dot.setAttribute("aria-current", String(isActive));
        const fill = dot.querySelector<HTMLElement>(".fill");
        if (fill) {
          fill.style.animation = "none";
          if (isActive) {
            void fill.offsetWidth; // Force reflow to guarantee CSS progress animation restarts
            fill.style.animation = "";
          }
        }
      });
    };

    const go = (next: number, force = false) => {
      const target = (next + total) % total;
      if (!force && target === index && timerId !== null) {
        return;
      }
      index = target;

      slideEls.forEach((el) => {
        const active = Number(el.dataset.slide) === index;
        el.toggleAttribute("data-active", active);
        el.toggleAttribute("inert", !active);
        if (el.getAttribute("role") === "group")
          el.setAttribute("aria-hidden", String(!active));
      });

      resetDotAnimation(index);
      scheduleNextSlide(duration);
    };

    // Navigation Controls
    root
      .querySelector("[data-prev]")
      ?.addEventListener("click", () => go(index - 1));
    root
      .querySelector("[data-next]")
      ?.addEventListener("click", () => go(index + 1));
    dots.forEach((dot) =>
      dot.addEventListener("click", () => go(Number(dot.dataset.dot))),
    );

    pauseBtn.addEventListener("click", () => {
      userPaused = !userPaused;
      sync();
    });

    // Targeted hover pause: only over imagery or controls, not the entire hero grid
    const mediaWrap = root.querySelector<HTMLElement>(
      ".aspect-\\[4\\/3\\]",
    )?.parentElement;
    const controlsWrap = root.querySelector<HTMLElement>("[data-controls]");
    [mediaWrap, controlsWrap].forEach((area) => {
      if (!area) return;
      area.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") {
          hovering = true;
          sync();
        }
      });
      area.addEventListener("pointerleave", () => {
        hovering = false;
        sync();
      });
    });

    // Keyboard focus pause (WCAG)
    stage.addEventListener("focusin", (e) => {
      if ((e.target as HTMLElement).matches(":focus-visible")) {
        focused = true;
        sync();
      }
    });
    stage.addEventListener("focusout", () => {
      focused = false;
      sync();
    });
    stage.addEventListener("pointerdown", () => {
      focused = false;
      sync();
    });

    // Keyboard arrows
    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") go(index - 1);
      else if (e.key === "ArrowRight") go(index + 1);
    });

    // Touch swipe
    let startX = 0;
    let startY = 0;
    stage.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "touch") return;
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener("pointerup", (e) => {
      if (e.pointerType !== "touch") return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5)
        go(index + (dx < 0 ? 1 : -1));
    });

    // Scroll offscreen check
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([entry]) => {
          offscreen = !entry.isIntersecting;
          sync();
        },
        { threshold: 0.1 },
      ).observe(root);
    }

    document.addEventListener("visibilitychange", sync);
    window.addEventListener("blur", () => {
      hovering = false;
      focused = false;
      sync();
    });

    // Handle loader integration: restart clean countdown once curtain lifts
    if (document.documentElement.classList.contains("is-loading")) {
      const loaderObserver = new MutationObserver(() => {
        if (!document.documentElement.classList.contains("is-loading")) {
          loaderObserver.disconnect();
          go(0, true);
        }
      });
      loaderObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
    } else {
      go(0, true);
    }

    sync();

    // Stats count-up (the ratio has no data-count and stays static)
    const counters = root.querySelectorAll<HTMLElement>("[data-count]");
    if (!reduced && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            io.unobserve(entry.target);

            const el = entry.target as HTMLElement;
            const target = Number(el.dataset.count);
            const suffix = el.dataset.suffix ?? "";
            const duration = 1400;
            const start = performance.now();

            const tick = (now: number) => {
              const t = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = `${Math.round(target * eased)}${suffix}`;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.6 },
      );
      counters.forEach((el) => io.observe(el));
    }
  }
</script>
