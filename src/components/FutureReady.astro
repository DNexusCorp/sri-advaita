---
/**
 * FutureReady.astro — Future-Ready Education Section
 * Blends practical digital thinking, hands-on STEM experimentation, and essential life skills.
 */

const pillars = [
  {
    title: "Using technology wisely",
    description:
      "Children get a gentle, age-appropriate look at smart tools and AI. We talk about what these tools are good for, and when to switch them off.",
    image: "/images/future-ai.png",
    alt: "Students using digital learning tools in class",
    badge: "Technology",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Computers and coding basics",
    description:
      "Children learn to type properly and get their first taste of the step-by-step thinking behind code. Staying safe online is part of it.",
    image: "/images/future-digital.png",
    alt: "A student working at a computer",
    badge: "Computers",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  },
  {
    title: "Science by doing",
    description:
      "Real kits for physics, chemistry and biology let children test an idea and see what happens, even when it goes wrong.",
    image: "/images/future-stem.png",
    alt: "A student doing a hands-on science experiment",
    badge: "Science",
    icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
  },
  {
    title: "Confidence and life skills",
    description:
      "Children practise speaking up and working as a team, and they learn to be kind when it isn't easy. Karate classes teach self-defence.",
    image: "/images/future-skills.png",
    alt: "Students practising teamwork and communication",
    badge: "Life skills",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
];
---

<section
  id="future-ready"
  class="relative isolate overflow-hidden bg-slate-50/70 py-16 text-brand-navy tab:py-20 lg:py-28 border-y border-slate-200/60"
  aria-labelledby="future-ready-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-gold-dark mb-3"
      >
        Future-ready skills
      </span>
      <h2
        id="future-ready-heading"
        class="font-serif text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
      >
        Useful skills, <span class="font-normal italic text-brand-gold-dark"
          >taught at a child's pace.</span
        >
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-brand-navy/75 sm:text-lg"
      >
        Nobody can say what work today's five-year-olds will end up doing. So we
        don't chase every new gadget. We teach what lasts, like asking good
        questions and working well with others, and bring in technology where it
        helps. We also pay as much attention to how a child treats people as to
        how quickly they learn.
      </p>
    </header>

    <!-- 4 Cards Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((item) => (
          <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-brand-gold/50 hover:shadow-xl">
            <div class="relative mb-5 aspect-[16/10] w-full overflow-hidden rounded-2xl bg-slate-100">
              <img
                src={item.image}
                alt={item.alt}
                width="320"
                height="200"
                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute left-3 top-3 rounded-full bg-brand-navy-dark/85 px-3 py-1 text-[11px] font-semibold text-brand-gold-light backdrop-blur-md">
                {item.badge}
              </span>
            </div>

            <div class="flex flex-1 flex-col justify-between">
              <div>
                <div class="mb-2 flex items-center gap-2">
                  <svg
                    class="h-5 w-5 text-brand-gold-dark"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={item.icon}
                    />
                  </svg>
                  <h3 class="font-serif text-base font-bold text-brand-navy">
                    {item.title}
                  </h3>
                </div>

                <p class="text-xs text-slate-600 leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Balanced Technology Banner -->
    <div
      class="mt-12 overflow-hidden rounded-3xl bg-brand-navy p-8 text-white shadow-xl sm:p-10"
    >
      <div class="grid items-center gap-6 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <span
            class="mb-2 inline-block text-xs font-bold uppercase tracking-[0.2em] text-brand-gold-light"
          >
            Our rule of thumb
          </span>
          <h3
            class="font-serif text-2xl font-bold tracking-tight text-white sm:text-3xl"
          >
            Teachers do the teaching. Technology helps.
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">
            We bring in digital tools when they make an idea clearer. They don't
            stand in for the teacher or for playtime. And when a lesson works
            better without a screen, we simply leave it off.
          </p>
        </div>
        <div
          class="flex flex-col gap-3 sm:flex-row lg:col-span-4 lg:justify-end"
        >
          <a
            href="#learning-spaces"
            class="inline-flex items-center justify-center rounded-xl bg-brand-gold px-6 py-3.5 text-sm font-bold text-brand-navy shadow-md transition-all duration-200 hover:bg-brand-gold-light hover:shadow-lg"
          >
            See our learning spaces
            <svg
              class="ml-2 h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
