<style>
  /* ---------- Hover and focus feedback ---------- */

  /* Underline that grows from the left; works across wrapped lines */
  .fl {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    padding-bottom: 2px;
    transition:
      background-size 0.3s ease,
      color 0.2s ease;
  }
  .fl:hover,
  a:hover > .fl,
  a:focus-visible > .fl,
  .fl:focus-visible {
    background-size: 100% 1px;
  }

  /* Short gold tick that lengthens on hover */
  .tick {
    display: inline-block;
    width: 0.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
    transform: translateY(-0.28em);
    transition:
      width 0.3s ease,
      opacity 0.3s ease;
  }
  .nav-link:hover .tick,
  .nav-link:focus-visible .tick {
    width: 1rem;
    opacity: 1;
  }

  /* Short rule beneath column headings */
  .footer-heading {
    position: relative;
    padding-bottom: 0.75rem;
  }
  .footer-heading::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, currentColor, transparent);
  }

  .cta {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
  }
  .cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.55);
  }
  .cta:active {
    transform: translateY(0);
  }

  .ext-icon,
  .to-top-icon {
    transition: transform 0.25s ease;
  }
  a:hover > .ext-icon,
  a:focus-visible > .ext-icon {
    transform: translate(2px, -2px);
  }
  .to-top:hover .to-top-icon,
  .to-top:focus-visible .to-top-icon {
    transform: translateY(-2px);
  }

  /* ---------- Entrance sequence (JS adds data-motion, then data-visible) ---------- */
  .footer-rule {
    transform-origin: center;
  }

  [data-motion] .footer-rule {
    transform: scaleX(0);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-motion][data-visible] .footer-rule {
    transform: scaleX(1);
  }

  [data-motion] .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(300ms + var(--i, 0) * 90ms);
  }
  [data-motion][data-visible] .reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .fl,
    .tick,
    .cta,
    .ext-icon,
    .to-top-icon {
      transition: none;
    }
    .cta:hover {
      transform: none;
    }
    .animate-ping {
      animation: none;
    }
  }
</style>

<script>
  // Reveal the footer once, when it first scrolls into view.
  // Skipped entirely for reduced-motion users or browsers without IntersectionObserver,
  // in which case the footer is simply visible.
  const footer = document.querySelector<HTMLElement>("[data-footer]");
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (footer && !prefersReduced && "IntersectionObserver" in window) {
    footer.setAttribute("data-motion", "");
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          footer.setAttribute("data-visible", "");
          observer.disconnect();
        }
      },
      { threshold: 0.1 },
    );
    observer.observe(footer);
  }
</script>
