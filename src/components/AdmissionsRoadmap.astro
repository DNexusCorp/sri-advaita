---
/**
 * AdmissionsRoadmap.astro — Complete guide for Academic Year 2027–28.
 * Features a 4-step admissions journey, clear age eligibility matrix,
 * fee/policy clarity, and downloadable prospectus trigger.
 */
interface Step {
  step: string;
  title: string;
  subtitle: string;
  description: string;
  badge: string;
  iconPath: string;
}

const steps: Step[] = [
  {
    step: "01",
    title: "Inquiry & Campus Tour",
    subtitle: "Experience the Advaita Spirit",
    description:
      "Schedule a personalized guided walkthrough of our Mookandapalli campus. Meet educators, explore smart classrooms, science labs, and observe our activity-centered learning spaces in action.",
    badge: "Step 1 — Discovery",
    iconPath:
      "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z",
  },
  {
    step: "02",
    title: "Child-Centered Dialogue",
    subtitle: "No Stressful Entrance Tests",
    description:
      "We believe every child is naturally curious. Our friendly, informal interaction assesses emotional readiness, social curiosity, and developmental milestones rather than rote memorization.",
    badge: "Step 2 — Interaction",
    iconPath:
      "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    step: "03",
    title: "Application & Verification",
    subtitle: "Transparent Documentation",
    description:
      "Submit the registration form along with essential records (Birth Certificate, Address Proof, previous school marksheet if applicable, and passport photos). Our admissions desk assists at every step.",
    badge: "Step 3 — Documentation",
    iconPath:
      "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
  {
    step: "04",
    title: "Admission Confirmation",
    subtitle: "Welcome to the Family",
    description:
      "Receive your formal offer letter and Welcome Orientation Kit (including the Little Elly Early Childhood Learning Kit for Nursery to UKG), detailing uniform guidelines, academic calendar, bus routes, parent mobile app credentials, and books list.",
    badge: "Step 4 — Enrolment",
    iconPath:
      "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
];

const ageMatrix = [
  {
    grade: "Nursery (Pre-KG)",
    partner: "Little Elly Collaboration",
    age: "2.5 – 3.5 Years",
    cutoff: "Born on or before 1st Oct 2024",
    stage: "Little Elly H.A.P.P.Y. Foundational Stage",
    ratio: "2:18 Mentorship",
    seats: "Limited to 25 Seats",
  },
  {
    grade: "Junior KG (LKG)",
    partner: "Little Elly Collaboration",
    age: "3.5 – 4.5 Years",
    cutoff: "Born on or before 1st Oct 2023",
    stage: "Little Elly H.A.P.P.Y. Phonics & Sensory",
    ratio: "2:20 Mentorship",
    seats: "Limited to 30 Seats",
  },
  {
    grade: "Senior KG (UKG)",
    partner: "Little Elly Collaboration",
    age: "4.5 – 5.5 Years",
    cutoff: "Born on or before 1st Oct 2022",
    stage: "Little Elly H.A.P.P.Y. School Readiness",
    ratio: "2:20 Mentorship",
    seats: "Limited to 30 Seats",
  },
  {
    grade: "Grade 1 (Primary)",
    partner: "State Board Stream",
    age: "5.5 – 6.5 Years",
    cutoff: "Born on or before 1st Oct 2021",
    stage: "State Board Preparatory Stage",
    ratio: "1:15 Mentorship",
    seats: "Admissions Open",
  },
  {
    grade: "Grades 2 to 5",
    partner: "State Board Stream",
    age: "6.5 – 10.5 Years",
    cutoff: "As per NEP / State Norms",
    stage: "State Board Primary Stream",
    ratio: "1:15 Mentorship",
    seats: "Subject to Vacancies",
  },
  {
    grade: "Grades 6 to 8",
    partner: "State Board Stream",
    age: "10.5 – 13.5 Years",
    cutoff: "Transfer Certificate Required",
    stage: "State Board Middle School & STEAM",
    ratio: "1:18 Mentorship",
    seats: "Subject to Vacancies",
  },
];
---

<section
  id="admissions"
  class="relative isolate overflow-hidden bg-brand-cream py-16 text-brand-navy sm:py-20 lg:py-28"
  aria-labelledby="admissions-heading"
>
  <!-- Decorative Ambient Glows -->
  <div
    class="pointer-events-none absolute -left-20 top-20 -z-10 h-72 w-72 rounded-full bg-brand-gold/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 bottom-10 -z-10 h-80 w-80 rounded-full bg-brand-navy/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mx-auto mb-14 max-w-3xl text-center lg:mb-20">
      <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-gold-dark">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Admissions Open 2027–2028
      </div>

      <h2
        id="admissions-heading"
        class="reveal font-serif text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
      >
        Your Simple 4-Step Enrolment Roadmap
      </h2>

      <p class="reveal mx-auto mt-4 max-w-2xl text-base text-brand-navy/75 sm:text-lg">
        We make school admissions transparent, personal, and stress-free. No high-pressure testing — just collaborative partnerships with parents.
      </p>
    </header>

    <!-- 4-Step Visual Pathway Grid -->
    <div class="reveal-stagger mb-20 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((item) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-brand-navy/10 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-brand-gold/40 hover:shadow-card-hover">
            <!-- Step Number Pill & Icon -->
            <div>
              <div class="mb-5 flex items-center justify-between">
                <span class="font-serif text-2xl font-bold text-brand-gold-dark opacity-80 group-hover:opacity-100">
                  {item.step}
                </span>
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gold/15 text-brand-gold-dark transition-colors duration-300 group-hover:bg-brand-gold group-hover:text-white">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.iconPath} />
                  </svg>
                </span>
              </div>

              <span class="mb-2 inline-block rounded-md bg-brand-cream-dark px-2.5 py-0.5 text-xs font-semibold text-brand-navy/70">
                {item.badge}
              </span>

              <h3 class="mb-1 text-xl font-bold text-brand-navy group-hover:text-brand-gold-dark transition-colors">
                {item.title}
              </h3>
              <p class="mb-3 text-xs font-medium text-brand-gold-dark">
                {item.subtitle}
              </p>

              <p class="text-sm leading-relaxed text-brand-navy/70">
                {item.description}
              </p>
            </div>

            <!-- Footer indicator -->
            <div class="mt-6 pt-4 border-t border-brand-navy/5 flex items-center text-xs font-semibold text-brand-navy/60 group-hover:text-brand-gold-dark">
              <span>Learn more</span>
              <svg class="ml-1.5 h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Age Eligibility Matrix Box -->
    <div class="reveal overflow-hidden rounded-3xl border border-brand-navy/15 bg-white shadow-premium">
      <div class="border-b border-brand-navy/10 bg-brand-navy p-6 sm:p-8 text-brand-cream flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-brand-gold/20 px-3 py-1 text-xs font-semibold text-brand-gold-light mb-2">
            Academic Year 2027–2028
          </div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold">
            Age Criteria & Class Eligibility Matrix
          </h3>
          <p class="text-xs sm:text-sm text-brand-cream/70 mt-1">
            Calculated as per National Education Policy (NEP) and State Education Department norms.
          </p>
        </div>

        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-xl bg-brand-gold px-5 py-3 text-sm font-bold text-brand-navy-dark shadow-sm transition-all hover:bg-brand-gold-light hover:shadow-glow-gold flex-none"
        >
          Check Child’s Eligibility
        </a>
      </div>

      <!-- Table Wrapper -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-brand-cream-dark/50 border-b border-brand-navy/10 text-xs font-bold uppercase tracking-wider text-brand-navy/70">
              <th scope="col" class="py-4 px-6">Grade / Offering</th>
              <th scope="col" class="py-4 px-6">Eligible Age Range</th>
              <th scope="col" class="py-4 px-6 hidden sm:table-cell">Cut-off Guideline</th>
              <th scope="col" class="py-4 px-6 hidden md:table-cell">Curriculum Stage</th>
              <th scope="col" class="py-4 px-6 text-right">Seat Availability</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-navy/5">
            {
              ageMatrix.map((row, idx) => (
                <tr class={idx % 2 === 0 ? "bg-white hover:bg-brand-gold/5" : "bg-brand-cream/20 hover:bg-brand-gold/5"}>
                  <td class="py-4 px-6 font-bold text-brand-navy">
                    <div class="flex items-start gap-2">
                      <span class="mt-1.5 h-2 w-2 flex-none rounded-full bg-brand-gold"></span>
                      <div>
                        <span class="block">{row.grade}</span>
                        {row.partner && (
                          <span class={`inline-block mt-0.5 text-[11px] font-semibold ${row.partner.includes('Little Elly') ? 'text-brand-gold-dark font-bold' : 'text-brand-navy/60'}`}>
                            {row.partner}
                          </span>
                        )}
                      </div>
                    </div>
                  </td>
                  <td class="py-4 px-6 font-semibold text-brand-gold-dark">
                    {row.age}
                  </td>
                  <td class="py-4 px-6 text-xs text-brand-navy/70 hidden sm:table-cell">
                    {row.cutoff}
                  </td>
                  <td class="py-4 px-6 text-xs text-brand-navy/80 hidden md:table-cell">
                    <span class="inline-block rounded-md bg-brand-cream-dark px-2.5 py-1">
                      {row.stage}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-right font-medium">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      {row.seats}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Bottom Banner & Document Checklist -->
      <div class="border-t border-brand-navy/10 bg-brand-cream/30 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <h4 class="text-sm font-bold text-brand-navy flex items-center gap-2">
            <svg class="h-4 w-4 text-brand-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Required Documents for Verification
          </h4>
          <p class="text-xs text-brand-navy/70 leading-relaxed max-w-2xl">
            Child's Birth Certificate • Passport-sized photos (4) • Address Proof (Aadhaar / Voter ID / Utility Bill) • Previous school report card & Transfer Certificate (for Grade 2 onwards) • Immunization / Health record.
          </p>
        </div>

        <div class="flex items-center gap-3 flex-none w-full sm:w-auto">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-brand-navy/20 bg-white px-5 py-2.5 text-xs font-bold text-brand-navy transition hover:border-brand-gold hover:text-brand-gold-dark shadow-sm"
          >
            <svg class="h-4 w-4 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Download Prospectus
          </a>
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-brand-navy px-5 py-2.5 text-xs font-bold text-brand-cream transition hover:bg-brand-navy-light shadow-sm"
          >
            Book Campus Tour
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
