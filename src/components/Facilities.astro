const campusFacts = [
  {
    icon: "🏫",
    title: "Purpose-Built Campus",
    desc: "Modern two-storey facility in Mookandapalli",
  },
  {
    icon: "☀️",
    title: "Bright & Airy",
    desc: "Open verandahs and natural cross-light",
