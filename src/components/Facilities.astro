---

<section
  id="facilities"
  class="relative isolate overflow-hidden bg-brand-navy-dark py-16 text-brand-cream sm:py-20 lg:py-28"
  aria-labelledby="facilities-heading"
>
  <!-- Background Glows -->
  <div
    class="pointer-events-none absolute -left-20 top-20 -z-10 h-96 w-96 rounded-full bg-brand-gold/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-20 bottom-20 -z-10 h-96 w-96 rounded-full bg-brand-navy-light/40 blur-[130px]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mx-auto mb-14 max-w-3xl text-center lg:mb-16">
      <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-gold-light">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        Campus Infrastructure
      </div>

      <h2
        id="facilities-heading"
        class="reveal font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
      >
        State-of-the-Art Spaces for Growth
      </h2>

      <p class="reveal mx-auto mt-4 max-w-2xl text-base text-brand-cream/75 sm:text-lg">
        Designed from the ground up for safety, experiential exploration, and intellectual vitality in Mookandapalli, Hosur.
      </p>
    </header>

    <!-- Campus Quick Facts Strip -->
    <div class="reveal mb-16 grid grid-cols-2 gap-4 rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-md sm:grid-cols-4 sm:gap-6 sm:p-8">
      {
        campusFacts.map((fact) => (
          <div class="flex flex-col items-center text-center">
            <span class="text-3xl mb-2">{fact.icon}</span>
            <span class="font-serif font-bold text-white text-sm sm:text-base">{fact.title}</span>
            <span class="text-xs text-brand-cream/65 mt-1 leading-snug">{fact.desc}</span>
          </div>
        ))
      }
    </div>

    <!-- 6-Card Facilities Grid -->
    <div class="reveal-stagger grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        facilities.map((facility) => (
          <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-brand-navy/60 backdrop-blur-md shadow-premium transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-gold/50 hover:shadow-glow-gold">
            <!-- Facility Image Preview with Overlay -->
            <div class="relative h-52 w-full overflow-hidden bg-brand-navy">
              <img
                src={facility.image}
                alt={facility.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy-dark via-brand-navy-dark/40 to-transparent"></div>

              <!-- Category Badge -->
              <div class="absolute top-4 left-4">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-navy-dark/80 px-3 py-1 text-xs font-semibold text-brand-gold-light backdrop-blur-md border border-brand-gold/30">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-gold"></span>
                  {facility.category}
                </span>
              </div>

              <!-- Top Right Highlight Badge -->
              <div class="absolute top-4 right-4">
                <span class="inline-flex items-center rounded-full bg-brand-gold/90 px-3 py-1 text-xs font-bold text-brand-navy-dark shadow-sm">
                  {facility.badge}
                </span>
              </div>
            </div>

            <!-- Card Body Content -->
            <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
              <div>
                <div class="mb-3 flex items-center gap-3">
                  <div class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-brand-gold/15 text-brand-gold-light ring-1 ring-brand-gold/30 group-hover:bg-brand-gold group-hover:text-brand-navy-dark transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={facility.icon} />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-serif text-lg font-bold text-white group-hover:text-brand-gold-light transition-colors">
                      {facility.title}
                    </h3>
                    <p class="text-xs font-medium text-brand-gold">
                      {facility.subtitle}
                    </p>
                  </div>
                </div>

                <p class="mb-5 text-sm leading-relaxed text-brand-cream/70">
                  {facility.description}
                </p>

                <!-- Key Specs List -->
                <ul class="mb-6 space-y-2 border-t border-white/5 pt-4">
                  {facility.specs.map((spec) => (
                    <li class="flex items-center gap-2 text-xs text-brand-cream/80">
                      <svg class="h-4 w-4 text-brand-gold flex-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{spec}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Action Link -->
              <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                <a
                  href="#contact"
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-gold-light transition-colors hover:text-white"
                >
                  Schedule Tour of this Space
                  <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Safe and Caring Campus Environment Section (from index.html) -->
    <div id="safety" class="reveal mt-16 overflow-hidden rounded-3xl border border-white/10 bg-brand-navy p-8 text-white shadow-xl sm:p-10 lg:p-12">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-gold block mb-2">
            Uncompromised Security
          </span>
          <h3 class="font-serif text-2xl font-bold text-white sm:text-3xl lg:text-4xl">
            A Safe and Caring Campus Environment
          </h3>
          <p class="mt-4 text-sm leading-relaxed text-slate-300 sm:text-base">
            The physical protection and peace of mind of every child represent our highest baseline priority. We manage comprehensive checks and architectures to protect our spaces.
          </p>
          <div class="mt-6 inline-flex items-center gap-3 rounded-2xl border border-brand-gold/30 bg-brand-gold/10 p-4">
            <span class="text-2xl">🛡️</span>
            <div>
              <h5 class="text-xs font-bold uppercase tracking-wider text-brand-gold-light">Complete Peace of Mind</h5>
              <p class="text-xs text-slate-300">Strict background verifications and real-time network tracking.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-4">
          {
            safetyPillars.map((p) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition hover:border-brand-gold/40">
                <span class="text-2xl mb-2 block">{p.icon}</span>
                <h4 class="font-semibold text-brand-gold text-sm mb-1">{p.title}</h4>
                <p class="text-xs text-slate-300 leading-relaxed">{p.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
