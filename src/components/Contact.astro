---
/**
 * Contact.astro — Campus contact section: details, embedded map and an
 * enquiry form for Sri Advaita Educational Trust, Hosur.
 *
 * This section owns the `#contact` anchor that the navigation, hero and
 * programs buttons point to. (The footer's id is now `site-footer`.)
 *
 * Layout
 *  - One rounded panel. lg and up: navy "visit us" column (details + map)
 *    on the left, white form on the right. Below lg it stacks with the form
 *    first, because sending an enquiry is the main job on a phone.
 *  - The map grows to fill whatever height the form needs, so the two
 *    columns always end on the same line.
 *
 * Form
 *  - Native validation, 16px fields (no iOS zoom), autocomplete hints,
 *    honeypot against bots, live status messages.
 *  - Sends JSON to PUBLIC_CONTACT_ENDPOINT when that env var is set
 *    (Formspree, Web3Forms, Netlify, your own API route, etc.).
 *  - With no endpoint it falls back to opening a pre-filled email to the
 *    admissions address, so it works on day one.
 *
 * Map: Google Maps embed by address, loaded lazily. For an exact pin, replace
 * `mapEmbedSrc` with the URL from Google Maps > Share > Embed a map.
 *
 * Motion: the panel fades up once on scroll; the map fades in when loaded.
 * Skipped for reduced-motion users, and nothing is hidden without JavaScript.
 */

// Details used across the site (footer, hero, programs)
const school = {
  name: "Sri Advaita Educational Trust",
  addressLines: [
    "Plot No: 13, Manickavasagar Street,",
    "Mookandapalli, MGR Nagar,",
    "Hosur – 635126, Tamil Nadu",
  ],
  addressNote: "Near Bangalore border",
  email: "advaita@advaitaapp.com",
  phones: [
    { href: "tel:+917259526202", label: "+91 72595 26202" },
    { href: "tel:+917899920795", label: "+91 78999 20795" },
  ],
};

const mapQuery =
  "Manickavasagar Street, Mookandapalli, MGR Nagar, Hosur, Tamil Nadu 635126";
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;

const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";

const purposes = [
  "Admission enquiry",
  "Campus visit / Tour",
  "Bus route enquiry",
  "General question",
];

const timeSlots = [
  "Morning (10:00 AM – 12:00 PM)",
  "Afternoon (02:00 PM – 04:00 PM)",
  "Saturday Open House (10:00 AM – 01:00 PM)",
  "Callback Only",
];

const busRouteHubs = [
  "Mookandapalli / MGR Nagar",
  "Hosur Town / Bus Stand",
  "SIPCOT Phase 1 & 2",
  "Bagalur Road / Mathigiri",
  "Attibele / Bangalore Border",
  "Self Commute (No Bus Required)",
];

const classOptions = [
  "Little Elly Nursery (Pre-KG)",
  "Little Elly Junior KG (LKG)",
  "Little Elly Senior KG (UKG)",
  "Primary School (Grades 1–5)",
  "Middle School (Grades 6–8)",
  "Not sure yet",
];

const focusRing =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2";
const field =
  "block w-full rounded-xl border border-brand-navy/15 bg-brand-cream/40 px-4 py-3 text-base text-brand-navy placeholder:text-brand-navy/40 transition-[border-color,box-shadow,background-color] duration-200 hover:border-brand-navy/30 focus:border-brand-gold focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-gold/20";
const label = "mb-1.5 block text-sm font-semibold text-brand-navy";
const iconBadge =
  "flex h-10 w-10 flex-none items-center justify-center rounded-full bg-brand-gold/10 text-brand-gold ring-1 ring-brand-gold/25";
---

<section
  id="contact"
  data-contact
  class="relative isolate overflow-hidden bg-brand-cream py-16 text-brand-navy sm:py-20 lg:py-28"
  aria-labelledby="contact-heading"
>
  <!-- Decorative glow -->
  <div
    class="pointer-events-none absolute -left-24 top-10 -z-10 h-80 w-80 rounded-full bg-brand-gold/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -right-24 -z-10 h-80 w-80 rounded-full bg-brand-navy/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header
      class="mx-auto mb-12 max-w-3xl text-center lg:mb-16"
      data-reveal
      style="--d:0"
    >
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-4 py-1.5 text-sm font-semibold text-brand-gold-dark"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-gold/70 motion-reduce:animate-none"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-gold"
          ></span>
        </span>
        Admissions open for 2027–28
      </p>
      <h2
        id="contact-heading"
        class="text-balance font-serif text-3xl font-bold leading-tight tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
      >
        Get in touch with Sri Advaita
      </h2>
      <div
        class="mx-auto mt-5 h-0.5 w-14 rounded-full bg-gradient-to-r from-brand-gold to-brand-gold-dark"
        aria-hidden="true"
      >
      </div>
      <p
        class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-brand-navy/70 sm:text-lg"
      >
        Ask about admissions for Little Elly Early Years (Nursery to UKG) and State Board Grades 1 to 8, book a campus visit, or
        send us a question. The admissions desk is happy to help.
      </p>
    </header>

    <!-- Contact panel -->
    <div
      class="grid overflow-hidden rounded-3xl border border-brand-gold/20 bg-white shadow-xl shadow-brand-navy/10 lg:grid-cols-12"
      data-reveal
      style="--d:1"
    >
      <!-- Visit us: details and map (second on phones, first on desktop) -->
      <div
        class="order-2 flex flex-col gap-8 bg-brand-navy-dark p-6 text-brand-cream sm:p-8 lg:order-1 lg:col-span-5 lg:p-10"
      >
        <div>
          <h3 class="font-serif text-2xl font-bold leading-snug text-white">
            Visit the campus
          </h3>
          <p class="mt-2 max-w-sm text-sm leading-relaxed text-brand-cream/70">
            Come and see our classrooms, labs and green campus in Mookandapalli,
            near the Bangalore border.
          </p>
        </div>

        <address class="not-italic">
          <ul class="space-y-5 text-sm text-brand-cream/85">
            <li class="flex items-start gap-4">
              <span class={iconBadge}>
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </span>
              <div class="min-w-0 pt-1.5 leading-relaxed">
                <span class="block font-semibold text-white">{school.name}</span
                >
                {
                  school.addressLines.map((line) => (
                    <span class="block">{line}</span>
                  ))
                }
                <span class="mt-1 block text-brand-cream/60"
                  >{school.addressNote}</span
                >
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class={iconBadge}>
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </span>
              <div class="min-w-0 pt-1.5 leading-relaxed">
                <span class="block font-semibold text-white"
                  >Admissions desk</span
                >
                <span class="mt-0.5 flex flex-wrap gap-x-4 gap-y-1">
                  {
                    school.phones.map(({ href, label: phone }) => (
                      <a
                        href={href}
                        class={`link rounded-sm hover:text-brand-gold ${focusRing} focus-visible:ring-offset-brand-navy-dark`}
                      >
                        {phone}
                      </a>
                    ))
                  }
                </span>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <span class={iconBadge}>
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </span>
              <div class="min-w-0 pt-1.5 leading-relaxed">
                <span class="block font-semibold text-white">Email</span>
                <a
                  href={`mailto:${school.email}`}
                  class={`link break-all rounded-sm hover:text-brand-gold ${focusRing} focus-visible:ring-offset-brand-navy-dark`}
                >
                  {school.email}
                </a>
              </div>
            </li>
          </ul>
        </address>

        <!-- Visiting Hours & Guidelines -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-xs text-brand-cream/80 space-y-1 backdrop-blur-sm">
          <p class="font-bold text-brand-gold-light flex items-center gap-1.5">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Campus Visiting Hours
          </p>
          <p>Monday to Saturday: 09:00 AM – 04:30 PM</p>
          <p class="text-brand-cream/60">Sunday: By appointment for outstation & working parents</p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={directionsHref}
            target="_blank"
            rel="noopener noreferrer"
            class={`cta group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-gold to-brand-gold-light px-5 py-2.5 text-sm font-bold text-brand-navy shadow-md shadow-black/30 ${focusRing} focus-visible:ring-offset-brand-navy-dark`}
          >
            Get directions
            <span class="sr-only"> (opens in a new tab)</span>
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
          <a
            href={school.phones[0].href}
            class={`inline-flex items-center gap-2 rounded-full border border-brand-gold/40 px-5 py-2.5 text-sm font-semibold text-brand-cream transition-colors duration-300 hover:border-brand-gold hover:bg-brand-gold/10 hover:text-brand-gold-light ${focusRing} focus-visible:ring-offset-brand-navy-dark`}
          >
            Call admissions
          </a>
        </div>

        <!-- Map: fills the remaining column height so both columns end together -->
        <div
          class="map relative min-h-[16rem] flex-1 overflow-hidden rounded-2xl border border-white/10 bg-brand-navy sm:min-h-[20rem]"
          data-map
        >
          <iframe
            src={mapEmbedSrc}
            title="Map showing the Sri Advaita campus in Mookandapalli, Hosur"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 h-full w-full border-0"></iframe>
        </div>
      </div>

      <!-- Enquiry form (first on phones, second on desktop) -->
      <div class="order-1 p-6 sm:p-8 lg:order-2 lg:col-span-7 lg:p-10">
        <h3 class="font-serif text-2xl font-bold leading-snug text-brand-navy">
          Send an enquiry
        </h3>
        <p class="mt-2 max-w-lg text-sm leading-relaxed text-brand-navy/70">
          Tell us a little about your child and what you would like to know.
          Fields marked <span class="font-semibold text-brand-gold-dark">*</span
          > are required.
        </p>

        <form
          class="mt-8 space-y-6"
          data-contact-form
          data-endpoint={formEndpoint}
          data-email={school.email}
        >
          <!-- Honeypot: real visitors never see or fill this -->
          <div
            style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"
            aria-hidden="true"
          >
            <label>
              Leave this field empty
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <fieldset>
            <legend class={label}>What can we help with?</legend>
            <div class="flex flex-wrap gap-2.5">
              {
                purposes.map((purpose, i) => (
                  <label class="relative cursor-pointer">
                    <input
                      type="radio"
                      name="purpose"
                      value={purpose}
                      checked={i === 0}
                      class="peer sr-only"
                    />
                    <span class="pill block rounded-full border border-brand-navy/15 bg-white px-4 py-2 text-sm font-medium text-brand-navy/80 transition-colors duration-200 hover:border-brand-gold peer-checked:border-brand-navy peer-checked:bg-brand-navy peer-checked:text-brand-gold-light peer-focus-visible:ring-2 peer-focus-visible:ring-brand-gold peer-focus-visible:ring-offset-2">
                      {purpose}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="grid gap-x-5 gap-y-6 sm:grid-cols-2">
            <div>
              <label for="c-name" class={label}
                >Parent or guardian name <span
                  class="text-brand-gold-dark"
                  aria-hidden="true">*</span
                ></label
              >
              <input
                id="c-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your full name"
                data-field
                class={field}
              />
            </div>

            <div>
              <label for="c-phone" class={label}
                >Phone number <span
                  class="text-brand-gold-dark"
                  aria-hidden="true">*</span
                ></label
              >
              <input
                id="c-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                required
                autocomplete="tel"
                pattern="[0-9+\s\-]{10,15}"
                title="Enter a phone number with 10 to 15 digits"
                placeholder="+91 98765 43210"
                data-field
                class={field}
              />
            </div>

            <div>
              <label for="c-email" class={label}
                >Email <span class="font-normal text-brand-navy/50"
                  >(optional)</span
                ></label
              >
              <input
                id="c-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
                data-field
                class={field}
              />
            </div>

            <div>
              <label for="c-class" class={label}
                >Class of interest <span class="font-normal text-brand-navy/50"
                  >(optional)</span
                ></label
              >
              <div class="relative">
                <select
                  id="c-class"
                  name="class"
                  data-field
                  class={`${field} appearance-none pr-11`}
                >
                  <option value="">Select a class</option>
                  {
                    classOptions.map((option) => (
                      <option value={option}>{option}</option>
                    ))
                  }
                </select>
                <svg
                  class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-navy/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <div>
              <label for="c-slot" class={label}
                >Preferred visit slot <span class="font-normal text-brand-navy/50"
                  >(optional)</span
                ></label
              >
              <div class="relative">
                <select
                  id="c-slot"
                  name="preferred_slot"
                  data-field
                  class={`${field} appearance-none pr-11`}
                >
                  <option value="">Select visit time slot</option>
                  {
                    timeSlots.map((slot) => (
                      <option value={slot}>{slot}</option>
                    ))
                  }
                </select>
                <svg
                  class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-navy/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>

            <div>
              <label for="c-route" class={label}
                >Bus route / pickup hub <span class="font-normal text-brand-navy/50"
                  >(optional)</span
                ></label
              >
              <div class="relative">
                <select
                  id="c-route"
                  name="bus_route"
                  data-field
                  class={`${field} appearance-none pr-11`}
                >
                  <option value="">Select bus route area</option>
                  {
                    busRouteHubs.map((hub) => (
                      <option value={hub}>{hub}</option>
                    ))
                  }
                </select>
                <svg
                  class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-navy/50"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
          </div>

          <div>
            <label for="c-message" class={label}
              >Your message <span
                class="text-brand-gold-dark"
                aria-hidden="true">*</span
              ></label
            >
            <textarea
              id="c-message"
              name="message"
              rows="4"
              required
              minlength="10"
              placeholder="For example: we would like to visit the campus this Saturday and learn about Nursery admissions."
              data-field
              class={`${field} min-h-[7.5rem] resize-y`}></textarea>
          </div>

          <div
            class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="max-w-xs text-xs leading-relaxed text-brand-navy/60">
              We will reply using the details you share. You can also call the
              admissions desk any time.
            </p>
            <button
              type="submit"
              data-submit
              class={`submit group relative inline-flex w-full flex-none items-center justify-center gap-2 overflow-hidden rounded-full bg-brand-navy px-8 py-3.5 text-sm font-bold text-brand-gold-light shadow-lg shadow-brand-navy/25 transition-colors duration-300 hover:bg-brand-navy-light disabled:cursor-wait disabled:opacity-80 sm:w-auto ${focusRing} focus-visible:ring-offset-white`}
            >
              <span class="label-idle inline-flex items-center gap-2">
                Send enquiry
                <svg
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </span>
              <span class="label-busy items-center gap-2">
                <svg
                  class="h-4 w-4 animate-spin motion-reduce:animate-none"
                  fill="none"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-90"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                Sending
              </span>
            </button>
          </div>

          <!-- Live status: always in the page so screen readers announce changes -->
          <div class="status" role="status" aria-live="polite" data-status>
            <p data-status-text></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Links ---------- */
  .link {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    padding-bottom: 2px;
    transition:
      background-size 0.3s ease,
      color 0.2s ease;
  }
  .link:hover,
  .link:focus-visible {
    background-size: 100% 1px;
  }

  .cta {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
  }
  .cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }
  .cta:active {
    transform: translateY(0);
  }

  /* ---------- Form ---------- */
  [data-field]:user-invalid {
    border-color: #e11d48;
    background-color: #fff1f2;
  }
  [data-field]:user-invalid:focus {
    box-shadow: 0 0 0 4px rgb(225 29 72 / 0.15);
  }

  /* Submit: idle label by default, spinner label while sending */
  .label-busy {
    display: none;
  }
  .submit[data-loading] .label-idle {
    display: none;
  }
  .submit[data-loading] .label-busy {
    display: inline-flex;
  }

  /* Status message: collapsed (but still announced) until it has content */
  .status:not([data-tone]) {
    height: 0;
    overflow: hidden;
  }
  .status[data-tone] {
    animation: status-in 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .status[data-tone] p {
    border-radius: 0.75rem;
    border: 1px solid;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .status[data-tone="success"] p {
    color: #065f46;
    background: #ecfdf5;
    border-color: #a7f3d0;
  }
  .status[data-tone="info"] p {
    color: #1e3a8a;
    background: #eff6ff;
    border-color: #bfdbfe;
  }
  .status[data-tone="error"] p {
    color: #9f1239;
    background: #fff1f2;
    border-color: #fecdd3;
  }
  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Map: fades in once loaded (only when JS is running) ---------- */
  [data-js] .map iframe {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  [data-js] .map[data-loaded] iframe {
    opacity: 1;
  }

  /* ---------- Entrance: JS adds data-motion, then data-in per item ---------- */
  [data-motion] [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--d, 0) * 120ms);
  }
  [data-motion] [data-reveal][data-in] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .link,
    .cta,
    [data-js] .map iframe {
      transition: none;
    }
    .cta:hover {
      transform: none;
    }
    .status[data-tone] {
      animation: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-contact]");
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (section) {
    section.setAttribute("data-js", "");

    // ---------- Scroll reveal ----------
    if (!prefersReduced && "IntersectionObserver" in window) {
      const items = section.querySelectorAll<HTMLElement>("[data-reveal]");
      section.setAttribute("data-motion", "");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).setAttribute("data-in", "");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
      );
      items.forEach((item) => observer.observe(item));
    }

    // ---------- Map fade-in (with a fallback so it can never stay hidden) ----------
    const map = section.querySelector<HTMLElement>("[data-map]");
    const frame = map?.querySelector("iframe");
    if (map && frame) {
      const show = () => map.setAttribute("data-loaded", "");
      frame.addEventListener("load", show, { once: true });
      window.setTimeout(show, 5000);
    }

    // ---------- Form ----------
    const form = section.querySelector<HTMLFormElement>("[data-contact-form]");
    const submit = section.querySelector<HTMLButtonElement>("[data-submit]");
    const status = section.querySelector<HTMLElement>("[data-status]");
    const statusText = section.querySelector<HTMLElement>("[data-status-text]");

    const say = (tone: "success" | "info" | "error", message: string) => {
      if (!status || !statusText) return;
      statusText.textContent = message;
      status.setAttribute("data-tone", tone);
    };

    const clearStatus = () => {
      status?.removeAttribute("data-tone");
      if (statusText) statusText.textContent = "";
    };

    const setBusy = (busy: boolean) => {
      if (!submit) return;
      submit.toggleAttribute("data-loading", busy);
      submit.disabled = busy;
    };

    if (form) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault(); // native validation has already passed at this point
        clearStatus();

        const values = Object.fromEntries(
          new FormData(form).entries(),
        ) as Record<string, string>;

        // Honeypot filled: act as if it worked, send nothing
        if (values.website) {
          say("success", "Thank you. We have received your enquiry.");
          form.reset();
          return;
        }

        const endpoint = form.dataset.endpoint ?? "";
        const email = form.dataset.email ?? "";
        const first = (values.name ?? "").trim().split(" ")[0] || "there";

        const lines = [
          `Enquiry type: ${values.purpose ?? ""}`,
          `Name: ${values.name ?? ""}`,
          `Phone: ${values.phone ?? ""}`,
          values.email ? `Email: ${values.email}` : "",
          values.class ? `Class of interest: ${values.class}` : "",
          "",
          values.message ?? "",
        ].filter((line, i, all) => line !== "" || (i > 0 && all[i - 1] !== ""));

        // No endpoint configured: open a pre-filled email instead
        if (!endpoint) {
          const subject = `${values.purpose ?? "Enquiry"} from ${values.name ?? "website visitor"}`;
          window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
          say(
            "info",
            "Your email app should open with your enquiry filled in. Send it from there to reach the admissions desk.",
          );
          return;
        }

        setBusy(true);
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              purpose: values.purpose,
              name: values.name,
              phone: values.phone,
              email: values.email,
              class: values.class,
              message: values.message,
              _subject: `${values.purpose ?? "Enquiry"} from ${values.name ?? "website visitor"}`,
            }),
          });
          if (!response.ok)
            throw new Error(`Request failed: ${response.status}`);

          say(
            "success",
            `Thank you, ${first}. We have received your enquiry and will be in touch soon.`,
          );
          form.reset();
        } catch {
          say(
            "error",
            `We could not send your enquiry. Please call +91 72595 26202 or email ${email}.`,
          );
        } finally {
          setBusy(false);
        }
      });
    }
  }
</script>
