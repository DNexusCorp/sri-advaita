---
/**
 * Contact.astro — Campus contact section: details, embedded map and an
 * enquiry form for Sri Advaita Educational Trust, Hosur.
 *
 * This section owns the `#contact` anchor that the navigation, hero and
 * programs buttons point to. (The footer's id is now `site-footer`.)
 *
 * Layout
 *  - One rounded panel. lg and up: navy "visit us" column (details + map)
 *    on the left, white form on the right. Below lg it stacks with the form
 *    first, because sending an enquiry is the main job on a phone.
 *  - The map grows to fill whatever height the form needs, so the two
 *    columns always end on the same line.
 *
 * Form
 *  - Native validation, 16px fields (no iOS zoom), autocomplete hints,
 *    honeypot against bots, live status messages.
 *  - Sends JSON to PUBLIC_CONTACT_ENDPOINT when that env var is set
 *    (Formspree, Web3Forms, Netlify, your own API route, etc.).
 *  - With no endpoint it falls back to opening a pre-filled email to the
 *    admissions address, so it works on day one.
 *
 * Map: Google Maps embed by address, loaded lazily. For an exact pin, replace
 * `mapEmbedSrc` with the URL from Google Maps > Share > Embed a map.
 *
 * Motion: the panel fades up once on scroll; the map fades in when loaded.
 * Skipped for reduced-motion users, and nothing is hidden without JavaScript.
 */

// Details used across the site (footer, hero, programs)
const school = {
  name: "Sri Advaita Educational Trust",
  addressLines: [
    "H cross, Chintamani Road,",
    "Behind Saplamma Devi Temple,",
    "Shidlagatta Taluk, Chikkaballapura District – 562122, Karnataka",
  ],
  addressNote: "Shidlagatta Taluk, Chikkaballapura",
  email: "advaita@advaitaapp.com",
  phones: [
    { href: "tel:+917259526202", label: "+91 72595 26202" },
    { href: "tel:+917899920795", label: "+91 78999 20795" },
  ],
};

const mapQuery =
  "H cross, Chintamani Road, Behind Saplamma Devi Temple, Shidlagatta Taluk, chikkaballapura district - 562122 Karnataka";
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=16&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`;

const formEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";

const timeSlots = [
  "Weekday morning, 10 AM to 12 PM",
  "Weekday afternoon, 2 PM to 4 PM",
  "Saturday open house, 10 AM to 1 PM",
  "No visit, just call me back",
];

const classOptions = [
  "Nursery",
  "LKG",
  "UKG",
  "Grades 1 to 5",
  "Grades 6 to 8",
  "Not sure yet",
];

const focusRing =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2";
const field =
  "block w-full rounded-xl border border-brand-navy/15 bg-brand-cream/40 px-4 py-3 text-base text-brand-navy placeholder:text-brand-navy/40 transition-[border-color,box-shadow,background-color] duration-200 hover:border-brand-navy/30 focus:border-brand-gold focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand-gold/20";
const label = "mb-1.5 block text-sm font-semibold text-brand-navy";
const iconBadge =
  "flex h-10 w-10 flex-none items-center justify-center rounded-full bg-brand-gold/10 text-brand-gold ring-1 ring-brand-gold/25";
---

<section
  id="contact"
  data-contact
  class="relative isolate overflow-hidden bg-brand-cream py-16 text-brand-navy sm:py-20 lg:py-28"
  aria-labelledby="contact-heading"
>
  <!-- Decorative glow -->
  <div
    class="pointer-events-none absolute -left-24 top-10 -z-10 h-80 w-80 rounded-full bg-brand-gold/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -right-24 -z-10 h-80 w-80 rounded-full bg-brand-navy/5 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header
      class="mx-auto mb-12 max-w-3xl text-center lg:mb-16"
      data-reveal
      style="--d:0"
    >
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-4 py-1.5 text-sm font-semibold text-brand-gold-dark"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-gold/70 motion-reduce:animate-none"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-gold"
          ></span>
        </span>
        Admissions open for 2027-28
      </p>
      <h2
        id="contact-heading"
        class="text-balance font-serif text-3xl font-bold leading-tight tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
      >
        Talk to us, or come and see the school
      </h2>
      <div
        class="mx-auto mt-5 h-0.5 w-14 rounded-full bg-gradient-to-r from-brand-gold to-brand-gold-dark"
        aria-hidden="true"
      >
      </div>
      <p
        class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-brand-navy/70 sm:text-lg"
      >
        Questions about admission or the bus route? Want to walk around before
        you decide? Call, write, or drop in. Someone from the admissions desk
        will get back to you.
      </p>
    </header>

    <!-- Admission Form Card (Centered, clean and focused) -->
    <div
      class="mx-auto max-w-3xl overflow-hidden rounded-3xl border border-brand-gold/25 bg-white p-6 shadow-xl shadow-brand-navy/10 sm:p-10 lg:p-12"
      data-reveal
      style="--d:1"
    >
      <div class="mb-8 text-center">
        <h3
          class="font-serif text-2xl font-bold leading-snug text-brand-navy sm:text-3xl"
        >
          Write to us
        </h3>
        <p
          class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-brand-navy/70"
        >
          A few lines is enough. We need your name, a phone number and your
          message (marked <span class="font-semibold text-brand-gold-dark"
            >*</span
          >). The rest is optional.
        </p>
      </div>

      <form
        class="space-y-6"
        data-contact-form
        data-endpoint={formEndpoint}
        data-email={school.email}
        data-phone={school.phones[0].label}
      >
        <!-- Honeypot: real visitors never see or fill this -->
        <div
          style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden"
          aria-hidden="true"
        >
          <label>
            Leave this field empty
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </label>
        </div>

        <div class="grid gap-x-5 gap-y-6 sm:grid-cols-2">
          <div>
            <label for="c-name" class={label}
              >Your name <span class="text-brand-gold-dark" aria-hidden="true"
                >*</span
              ></label
            >
            <input
              id="c-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Parent or guardian"
              data-field
              class={field}
            />
          </div>

          <div>
            <label for="c-phone" class={label}
              >Phone number <span
                class="text-brand-gold-dark"
                aria-hidden="true">*</span
              ></label
            >
            <input
              id="c-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              required
              autocomplete="tel"
              pattern="[0-9+\s\-]{10,15}"
              title="Enter a phone number with 10 to 15 digits"
              placeholder="+91 98765 43210"
              data-field
              class={field}
            />
          </div>

          <div>
            <label for="c-email" class={label}
              >Email <span class="font-normal text-brand-navy/50"
                >(optional)</span
              ></label
            >
            <input
              id="c-email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="you@example.com"
              data-field
              class={field}
            />
          </div>

          <div>
            <label for="c-class" class={label}
              >Class you are asking about <span
                class="font-normal text-brand-navy/50">(optional)</span
              ></label
            >
            <div class="relative">
              <select
                id="c-class"
                name="class"
                data-field
                class={`${field} appearance-none pr-11`}
              >
                <option value="">Choose a class</option>
                {
                  classOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-navy/50"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>

          <div class="sm:col-span-2">
            <label for="c-slot" class={label}
              >Best time to visit <span class="font-normal text-brand-navy/50"
                >(optional)</span
              ></label
            >
            <div class="relative">
              <select
                id="c-slot"
                name="preferred_slot"
                data-field
                class={`${field} appearance-none pr-11`}
              >
                <option value="">Choose a time</option>
                {timeSlots.map((slot) => <option value={slot}>{slot}</option>)}
              </select>
              <svg
                class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brand-navy/50"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        </div>

        <div>
          <label for="c-message" class={label}
            >What would you like to know? <span
              class="text-brand-gold-dark"
              aria-hidden="true">*</span
            ></label
          >
          <textarea
            id="c-message"
            name="message"
            rows="4"
            required
            minlength="10"
            placeholder="For example: we would like to visit this Saturday and ask about Nursery admission."
            data-field
            class={`${field} min-h-[7.5rem] resize-y`}></textarea>
        </div>

        <div class="flex justify-center pt-2">
          <button
            type="submit"
            data-submit
            class={`submit group relative inline-flex w-full sm:w-auto items-center justify-center gap-2 overflow-hidden rounded-full bg-brand-navy px-10 py-3.5 text-sm font-bold text-brand-gold-light shadow-lg shadow-brand-navy/25 transition-colors duration-300 hover:bg-brand-navy-light disabled:cursor-wait disabled:opacity-80 ${focusRing} focus-visible:ring-offset-white`}
          >
            <span class="label-idle inline-flex items-center gap-2">
              Send message
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </span>
            <span class="label-busy items-center gap-2">
              <svg
                class="h-4 w-4 animate-spin motion-reduce:animate-none"
                fill="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-90"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
              </svg>
              Sending
            </span>
          </button>
        </div>

        <!-- Live status: always in the page so screen readers announce changes -->
        <div class="status" role="status" aria-live="polite" data-status>
          <p data-status-text></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  /* ---------- Links ---------- */
  .link {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    padding-bottom: 2px;
    transition:
      background-size 0.3s ease,
      color 0.2s ease;
  }
  .link:hover,
  .link:focus-visible {
    background-size: 100% 1px;
  }

  .cta {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      filter 0.25s ease;
  }
  .cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }
  .cta:active {
    transform: translateY(0);
  }

  /* ---------- Form ---------- */
  [data-field]:user-invalid {
    border-color: #e11d48;
    background-color: #fff1f2;
  }
  [data-field]:user-invalid:focus {
    box-shadow: 0 0 0 4px rgb(225 29 72 / 0.15);
  }

  /* Submit: idle label by default, spinner label while sending */
  .label-busy {
    display: none;
  }
  .submit[data-loading] .label-idle {
    display: none;
  }
  .submit[data-loading] .label-busy {
    display: inline-flex;
  }

  /* Status message: collapsed (but still announced) until it has content */
  .status:not([data-tone]) {
    height: 0;
    overflow: hidden;
  }
  .status[data-tone] {
    animation: status-in 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .status[data-tone] p {
    border-radius: 0.75rem;
    border: 1px solid;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .status[data-tone="success"] p {
    color: #065f46;
    background: #ecfdf5;
    border-color: #a7f3d0;
  }
  .status[data-tone="info"] p {
    color: #1e3a8a;
    background: #eff6ff;
    border-color: #bfdbfe;
  }
  .status[data-tone="error"] p {
    color: #9f1239;
    background: #fff1f2;
    border-color: #fecdd3;
  }
  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Map: fades in once loaded (only when JS is running) ---------- */
  [data-js] .map iframe {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  [data-js] .map[data-loaded] iframe {
    opacity: 1;
  }

  /* ---------- Entrance: JS adds data-motion, then data-in per item ---------- */
  [data-motion] [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--d, 0) * 120ms);
  }
  [data-motion] [data-reveal][data-in] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .link,
    .cta,
    [data-js] .map iframe {
      transition: none;
    }
    .cta:hover {
      transform: none;
    }
    .status[data-tone] {
      animation: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-contact]");
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (section) {
    section.setAttribute("data-js", "");

    // ---------- Scroll reveal ----------
    if (!prefersReduced && "IntersectionObserver" in window) {
      const items = section.querySelectorAll<HTMLElement>("[data-reveal]");
      section.setAttribute("data-motion", "");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).setAttribute("data-in", "");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
      );
      items.forEach((item) => observer.observe(item));
    }

    // ---------- Map fade-in (with a fallback so it can never stay hidden) ----------
    const map = section.querySelector<HTMLElement>("[data-map]");
    const frame = map?.querySelector("iframe");
    if (map && frame) {
      const show = () => map.setAttribute("data-loaded", "");
      frame.addEventListener("load", show, { once: true });
      window.setTimeout(show, 5000);
    }

    // ---------- Form ----------
    const form = section.querySelector<HTMLFormElement>("[data-contact-form]");
    const submit = section.querySelector<HTMLButtonElement>("[data-submit]");
    const status = section.querySelector<HTMLElement>("[data-status]");
    const statusText = section.querySelector<HTMLElement>("[data-status-text]");

    const say = (tone: "success" | "info" | "error", message: string) => {
      if (!status || !statusText) return;
      statusText.textContent = message;
      status.setAttribute("data-tone", tone);
    };

    const clearStatus = () => {
      status?.removeAttribute("data-tone");
      if (statusText) statusText.textContent = "";
    };

    const setBusy = (busy: boolean) => {
      if (!submit) return;
      submit.toggleAttribute("data-loading", busy);
      submit.disabled = busy;
    };

    if (form) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault(); // native validation has already passed at this point
        clearStatus();

        const values = Object.fromEntries(
          new FormData(form).entries(),
        ) as Record<string, string>;

        // Honeypot filled: act as if it worked, send nothing
        if (values.website) {
          say("success", "Thank you. We have your message.");
          form.reset();
          return;
        }

        const endpoint = form.dataset.endpoint ?? "";
        const email = form.dataset.email ?? "";
        const phone = form.dataset.phone ?? "";
        const first = (values.name ?? "").trim().split(/\s+/)[0] || "there";
        const subject = `${values.purpose ?? "Enquiry"} from ${values.name || "a website visitor"}`;

        const lines = [
          `About: ${values.purpose ?? ""}`,
          `Name: ${values.name ?? ""}`,
          `Phone: ${values.phone ?? ""}`,
          values.email ? `Email: ${values.email}` : "",
          values.class ? `Class: ${values.class}` : "",
          values.preferred_slot
            ? `Best time to visit: ${values.preferred_slot}`
            : "",
          "",
          values.message ?? "",
        ].filter((line, i, all) => line !== "" || (i > 0 && all[i - 1] !== ""));

        // No endpoint configured: open a pre-filled email instead
        if (!endpoint) {
          window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
          say(
            "info",
            "Your email app should open with your message filled in. Press send there and it reaches the admissions desk.",
          );
          return;
        }

        setBusy(true);
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              purpose: values.purpose,
              name: values.name,
              phone: values.phone,
              email: values.email,
              class: values.class,
              preferred_slot: values.preferred_slot,
              message: values.message,
              _subject: subject,
            }),
          });
          if (!response.ok)
            throw new Error(`Request failed: ${response.status}`);

          say(
            "success",
            `Thank you, ${first}. We have your message and will call or write back soon.`,
          );
          form.reset();
        } catch {
          say(
            "error",
            `That did not go through. Please call ${phone} or email ${email}.`,
          );
        } finally {
          setBusy(false);
        }
      });
    }
  }
</script>
