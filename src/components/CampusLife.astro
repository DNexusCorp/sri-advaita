---

<section
  id="campus-life"
  class="relative isolate overflow-hidden bg-brand-cream py-16 text-brand-navy sm:py-20 lg:py-28"
  aria-labelledby="campus-life-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mx-auto mb-14 max-w-3xl text-center lg:mb-20">
      <div class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-gold-dark">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Student Experience
      </div>

      <h2
        id="campus-life-heading"
        class="reveal font-serif text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
      >
        A Day at Sri Advaita: Holistic & Joyful
      </h2>

      <p class="reveal mx-auto mt-4 max-w-2xl text-base text-brand-navy/75 sm:text-lg">
        Education is an orchestrated balance between quiet mindfulness, rigorous intellectual inquiry, joyful creativity, and outdoor vitality.
      </p>
      <div class="reveal mx-auto mt-4 inline-flex items-center gap-2 rounded-full border border-brand-gold/40 bg-brand-gold/15 px-4 py-1 text-xs font-semibold text-brand-gold-dark">
        <span>🐘 Little Elly Foundational Wing (Nursery to UKG): 08:30 AM – 12:30 PM (Gentle Half-Day Rhythm)</span>
      </div>
    </header>

    <!-- Visual Interactive Timeline -->
    <div class="relative mx-auto max-w-5xl">
      <!-- Center vertical spine line -->
      <div
        class="absolute left-6 top-3 bottom-3 w-0.5 bg-gradient-to-b from-brand-gold via-brand-navy/20 to-brand-gold md:left-1/2 md:-ml-px"
        aria-hidden="true"
      >
      </div>

      <div class="space-y-8 sm:space-y-12">
        {
          schedule.map((item, index) => {
            const isEven = index % 2 === 0;
            return (
              <div class="reveal relative flex flex-col md:flex-row items-start">
                
                <!-- Left Column (or empty for alternating layout on desktop) -->
                <div class={`w-full md:w-1/2 pl-16 md:pl-0 ${isEven ? "md:pr-12 md:text-right" : "md:order-last md:pl-12 md:text-left"}`}>
                  <div class="group rounded-2xl border border-brand-navy/10 bg-white p-6 sm:p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-brand-gold/50 hover:shadow-card-hover">
                    <!-- Badges -->
                    <div class={`mb-3 flex items-center gap-2 flex-wrap ${isEven ? "md:justify-end" : "md:justify-start"}`}>
                      <span class="inline-block rounded-md bg-brand-navy px-2.5 py-0.5 text-xs font-bold text-brand-gold-light">
                        {item.time}
                      </span>
                      <span class="inline-block rounded-md bg-brand-cream-dark px-2.5 py-0.5 text-xs font-semibold text-brand-navy/70">
                        {item.badge}
                      </span>
                    </div>

                    <h3 class="font-serif text-lg sm:text-xl font-bold text-brand-navy group-hover:text-brand-gold-dark transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-xs font-medium text-brand-gold-dark mt-0.5 mb-2.5">
                      {item.period} • {item.category}
                    </p>

                    <p class="text-xs sm:text-sm leading-relaxed text-brand-navy/70">
                      {item.description}
                    </p>
                  </div>
                </div>

                <!-- Central Milestone Node -->
                <div class="absolute left-6 -translate-x-1/2 md:left-1/2 flex h-10 w-10 items-center justify-center rounded-full border-4 border-brand-cream bg-brand-gold text-brand-navy-dark shadow-md z-10">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                  </svg>
                </div>

                <!-- Empty balancing side on desktop -->
                <div class={`hidden md:block md:w-1/2 ${isEven ? "md:order-last md:pl-12" : "md:pr-12"}`}></div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Bottom Action CTA -->
    <div class="reveal mt-16 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 rounded-2xl border border-brand-navy/10 bg-white p-6 shadow-card">
        <div class="text-left">
          <h4 class="font-serif text-base font-bold text-brand-navy">
            Would you like to observe our classes in real-time?
          </h4>
          <p class="text-xs text-brand-navy/70 mt-0.5">
            Parents are warmly invited to spend a morning on campus during our Open School Days.
          </p>
        </div>
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-xl bg-brand-navy px-6 py-2.5 text-xs font-bold text-brand-cream shadow-sm transition hover:bg-brand-navy-light flex-none"
        >
          Book Open School Visit
        </a>
      </div>
    </div>

  </div>
</section>
