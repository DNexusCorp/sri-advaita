 * CampusLife.astro — "A Day at Sri Advaita" Daily Rhythm.
 * Presents a student's holistic, balanced school day from
 * morning meditation to athletic vitality and safe return.
 */
interface ScheduleItem {
  time: string;
  period: string;
  title: string;
  category: string;
  description: string;
  icon: string;
  badge: string;
