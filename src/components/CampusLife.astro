    badge: "Inner Poise",
    icon: "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z",
  },
  {
    time: "09:15 AM",
    period: "Deep Focus 1",
    title: "Experiential STEAM & Conceptual Mathematics",
    category: "Intellectual Inquiry",
    description:
      "Students actively manipulate science apparatus, test robotics logic, solve geometric tangrams, and explore conceptual logic in collaborative groups rather than rote copying from the board.",
