---
/**
 * Leadership.astro — Founder & Academic Vision.
 * Showcases the guiding philosophy of Sri Advaita Educational Trust:
 * "ಹಳೆ ಬೇರು, ಹೊಸ ಚಿಗುರು — Old Roots. New Shoots".
 */
const leadershipPillars = [
  {
    title: "Values Over Competition",
    description: "Every child is an individual universe, not a test score. We foster intrinsic curiosity rather than artificial anxiety.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Experiential Mastery",
    description: "Concepts stay forever when discovered with the hands, analyzed with the mind, and shared with peers.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  },
  {
    title: "Non-Dual Oneness (Advaita)",
    description: "Instilling deep respect for nature, family, and humanity by teaching children the interconnectedness of all living things.",
    icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
  },
];
---

<section
  id="leadership"
  class="relative isolate overflow-hidden bg-brand-cream-dark/60 py-16 text-brand-navy sm:py-20 lg:py-28"
  aria-labelledby="leadership-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      
      <!-- Visual Quote & Founder Box (Left, 5 cols) -->
      <div class="reveal-left relative lg:col-span-5">
        <div class="relative overflow-hidden rounded-3xl border border-brand-navy/15 bg-white p-8 sm:p-10 shadow-premium">
          <!-- Kannada Motto Callout -->
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-brand-gold/30 bg-brand-gold/15 px-3.5 py-1 text-xs font-semibold text-brand-gold-dark">
            <span class="font-kannada">ಹಳೆ ಬೇರು, ಹೊಸ ಚಿಗುರು</span>
            <span>•</span>
            <span>Old Roots. New Shoots.</span>
          </div>

          <!-- Large Quote Sign -->
          <div class="font-serif text-6xl text-brand-gold/30 leading-none mb-2 select-none" aria-hidden="true">
            “
          </div>

          <blockquote class="font-serif text-xl sm:text-2xl font-semibold leading-relaxed text-brand-navy -mt-4">
            Education is not the filling of a bucket, but the lighting of a flame. We build grounded character first, and intellectual excellence follows naturally.
          </blockquote>

          <div class="mt-8 pt-6 border-t border-brand-navy/10 flex items-center gap-4">
            <div class="flex h-14 w-14 flex-none items-center justify-center rounded-2xl bg-brand-navy text-brand-gold-light ring-2 ring-brand-gold/40">
              <span class="font-serif text-xl font-bold">SA</span>
            </div>
            <div>
              <h4 class="font-serif text-base font-bold text-brand-navy">
                Governing Council & Mentors
              </h4>
              <p class="text-xs text-brand-navy/70">
                Sri Advaita Educational Trust, Hosur
              </p>
              <p class="text-[11px] text-brand-gold-dark font-medium mt-0.5">
                Serving the Mookandapalli Community Since 2010
              </p>
            </div>
          </div>
        </div>

        <!-- Decorative background ring -->
        <div class="pointer-events-none absolute -bottom-6 -right-6 -z-10 h-64 w-64 rounded-full border border-brand-gold/30 opacity-60" aria-hidden="true"></div>
      </div>

      <!-- Right Description & Philosophy (7 cols) -->
      <div class="reveal-right lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-navy/15 bg-white px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-navy/80 shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-gold"></span>
          Leadership & Pedagogy
        </div>

        <h2
          id="leadership-heading"
          class="font-serif text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl lg:text-5xl"
        >
          Rooted in Ancient Wisdom, Ready for the 21st Century
        </h2>

        <p class="text-base text-brand-navy/80 sm:text-lg leading-relaxed">
          At Sri Advaita Educational Trust, our educational compass is defined by the profound philosophical ethos of non-dual Advaita: that every learner holds infinite inner potential.
        </p>

        <p class="text-sm text-brand-navy/70 leading-relaxed">
          Situated at the intersection of Karnataka and Tamil Nadu near the Bangalore border, we celebrate rich multilingual linguistic heritage while preparing children for tomorrow’s global STEAM landscape with robotics, hands-on scientific kits, and ethical values.
        </p>

        <!-- 3 Leadership Pillars Grid -->
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3 pt-4 border-t border-brand-navy/10">
          {
            leadershipPillars.map((item) => (
              <div class="rounded-2xl border border-brand-navy/10 bg-white/80 p-5 shadow-sm transition-all hover:border-brand-gold/40 hover:bg-white">
                <div class="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-gold/15 text-brand-gold-dark">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                  </svg>
                </div>
                <h3 class="text-sm font-bold text-brand-navy mb-1.5">
                  {item.title}
                </h3>
                <p class="text-xs text-brand-navy/70 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="#admissions"
            class="inline-flex items-center gap-2 rounded-xl bg-brand-navy px-6 py-3 text-sm font-bold text-brand-cream shadow-sm transition hover:bg-brand-navy-light"
          >
            Admissions Process 2027–28
            <svg class="h-4 w-4 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-xl border border-brand-navy/20 bg-white px-6 py-3 text-sm font-bold text-brand-navy shadow-sm transition hover:border-brand-gold hover:text-brand-gold-dark"
          >
            Meet Our Academic Mentors
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
